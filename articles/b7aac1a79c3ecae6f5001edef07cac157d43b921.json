;,&quot;event&quot;:&quot;navigation&quot;,&quot;element_name&quot;:&quot;category_link&quot;}\">\n                \n                <li>\n                  <a data-track-click=\"\" href=\"/category/anthropic\" title=\"Anthropic\">Anthropic</a>\n                </li>      \n                <li>\n                  <a data-track-click=\"\" href=\"/category/ai\" title=\"AI\">AI</a>\n                </li>\n          \n            </ul>\n          </div>\n        </section>\n    \n    \n          <section data-track-page-area=\"Post Bottom\">\n          <!-- Included desktop \"taboola\" -->    <vendor-taboola data-component-type=\"vendor-taboola\" data-root-margin=\"0px 0px 100% 0px\" data-consent=\"MARKETING\" config=\"{&quot;providerName&quot;:&quot;taboola&quot;,&quot;providerPageType&quot;:{&quot;article&quot;:&quot;auto&quot;},&quot;providerUrl&quot;:&quot;https://cdn.taboola.com/libtrc/businessinsider/loader.js&quot;,&quot;providerPrivacyLoader&quot;:&quot;https://static.tblcontent.com/libtrc/businessinsider/loader.privacy.js&quot;,&quot;providerPixel&quot;:&quot;https://static.qovani.com/libtrc/tr5?type=pixel&publisher=businessinsider&quot;,&quot;providerFlushValue&quot;:{&quot;flush&quot;:true},&quot;providerData&quot;:{&quot;mode&quot;:&quot;thumbs-1r&quot;,&quot;container&quot;:&quot;taboola-below-main-column&quot;,&quot;placement&quot;:&quot;Below Article Thumbnails Logged Out&quot;,&quot;target_type&quot;:&quot;mix&quot;}}\" data-load-strategy=\"defer\">\n                \n              </vendor-taboola>\n          \n          <!-- Excluded mobile \"taboola\" --></section>\n    \n      </section>\n  </section>\n\n  \n  \n\n\n    <back-to-home data-component-type=\"back-to-home\" data-load-strategy=\"defer\" data-only-on=\"mobile\" inert=\"\">\n      \n  \n      \n  \n      \n    </back-to-home>\n</section></DIV>","content_text":"By Truman Dickerson You're currently following this author! Click to unsubscribe from email alerts. Adam Gray/Getty Images AI engine