t;:&quot;1&quot;,&quot;yTrafficOrigin&quot;:&quot;content-canvas default&quot;}\" target=\"_blank\">WEN</a>) report to cap a busy week of reports.<!-- HTML_TAG_END -->  </p>","sentences":[{"en":"On Friday, Vistra Corp. (VST), Take-Two Interactive Software (TTWO), Oklo (OKLO), Under Armour (UA), and Wendy's (WEN) report to cap a busy week of reports.","zh":"周五，Vistra Corp. (VST)、Take-Two Interactive Software (TTWO)、Oklo (OKLO)、Under Armour (UA) 和 Wendy's (WEN) 发布报告，为繁忙的一周报告画上句号。"}]},{"html_en":"<p><!-- HTML_TAG_START -->Overall, it's shaping up to be a <a href=\"https://finance.yahoo.com/markets/article/earnings-season-is-about-to-kick-off--2-charts-reveal-how-it-may-go-135222405.html\" data-ylk=\"slk:strong%20earnings%20season;elm:context_link;itc:0;sec:content-canvas;cpos:7;pos:1;_E:mb_qualified_link;ct:story;outcm:mb_qualified_link;source:content-canvas%20default\" data-yga=\"{&quot;yLinkText&quot;:&quot;strong earnings season&quot;,&quot;yLinkElement&quot;:&quot;context_link&quot;,&quot;yModuleName&quot;:&quot;content-canvas&quot;,&quot;yLinkPosition&quot;:&quot;7&quot;,&quot;yPosition&quot;:&quot;1&quot;,&quot;yContentType&quot;:&quot;story&quot;,&quot;yTrafficOrigin&quot;:&quot;content-canvas default&quot;}\" target=\"_blank\">strong earnings season</a> for the S&amp;P 500 (<a href=\"https://finance.yahoo.com/quote/%5EGSPC/\" data-ylk=\"slk:%5EGSPC;elm:context_link;itc:0;sec:content-canvas;cpos:8;pos:1;source:content-canvas%20default\" data-yga=\"{&quot;yLinkText&quot;:&quot;^GSPC&quot;,&quot;yLinkElement&quot;:&quot;context_link&quot;,&quot;yModuleName&quot;:&quot;content-canvas&quot;,&quot;yLinkPosition&quot;:&quot;8&quot;,&quot;yPosition&quot;:&quot;1&quot;,&quot;yTrafficOrigin&quot;:&quot;content-canvas default&quot;}\" target=\"_blank\">^GSPC</a>). According to <a href=\"https://advantage.factset.com/hubfs/Website/Resources%20Section/Research%20Desk/Earnings%20Insight/EarningsInsight_073126.pdf\" data-ylk=\"slk:FactSet%20data;elm:context_link;itc:0;sec:content-canvas;cpos:9;pos:1;source:content-canvas%20default\" data-yga=\"{&quot;yLinkText&quot;:&quot;FactSet data&quot;,&quot;yLinkElement&quot;:&quot;context_link&quot;,&quot;yModuleName&quot;:&quot;content-canvas&quot;,&quot;yLinkPosition&quot;:&quot;9&quot;,&quot;yPosition&quot;:&quot;1&quot;,&quot;yTrafficOrigin&quot;:&quot;content-canvas default&quot;}\" target=\"_blank\" rel=\"noopener noreferrer nofollow\">FactSet data</a>, analysts estimate the year-over-year S&amp;P 500 earnings growth rate for the second quarter will be 47.5% — surging past the five-year average of 16.4% and the 10-year average of 10.3%.<!-- HTML_TAG_END -->  </p>","sentences":[{"en":"Overall, it's shaping up to be a strong earnings season for the S&P 500 (^GSPC).","zh":"总体而言，标准普尔 500 指数 (^GSPC) 即将迎来强劲的财报季。"},{"en":"According to FactSet data, analysts estimate the year-over-year S&P 500 earnings growth rate for the second quarter will be 47.5% — surging past the five-year average of 16.4% and the 10-year average of 10.3%.","zh":"根据 FactSet 数据，分析师预计标普 500 指数第二季度盈利同比增长率将为 47.5%，大幅超过 16.4% 的五年平均水平和 10.3% 的 10 年平均水平。"}]},{"html_en":"<p><!-- HTML_TAG_START -->If that holds, it will mark the second consecutive quarter of earnings growth above 20% for the index and the seventh straight quarter of double-digit growth.<!-- HTML_TAG_END -->  </p>","sentences":[{"en":"If that holds, it will mark the second consecutive quarter of earnings growth above 20% for the index and the seventh straight quarter of double-digit growth.","zh":"如果这种情况成立，这将标志着该指数连续第二个季度盈利增长超过 20%，并且连续第七个季度实现两位数增长。"}]}],"translated":true,"content_html_zh":"<div class=\"page\" id=\"readability-page-1\"><div id=\"main-content-wrapper\">  <article data-testid=\"article-content-wrapper\">     <div><p><a data-ylk=\"elm:author;elmt:link;itc:0;source:content-canvas%20default;slk:Yahoo%20Finance;sec:content-canvas\" data-yga=\"{&quot;yLinkElement&quot;:&quot;author&quot;,&quot;yLinkElementType&quot;:&quot;link&quot;,&quot;yTrafficOrigin&quot;:&quot;content-canvas default&quot;,&quot;yLinkText&quot;:&quot;Yahoo Finance&quot;,&quot;yModuleName&quot;:&quot;content-canvas&quot;}\" href=\"/author/yahoo--finance\" target=\"_self\"><img src=\"https://s.yimg.com/lo/mysterio/api/0A0ACF0EC18AAC222F80FE408BA6F6D729A0CC57A71802FE671BB23D1AB87F5F/subgraphmysterio/resizefill_w80_h80;quality_80;format_webp/https:%2F%2Fo.aolcdn.com%2Fimages%2Fdims%3Fimage_uri=https%253A%252F%252Fs.yimg.com%252Fos%252Fcreatr-uploaded-images%252F2021-11%252F40621510-496f-11ec-bade-b5da9b9bb6b2&compress=1&progressive=1&quality=75&client=hawkeye&signature=5841425766d3c70312da70fc666899b924bf6740\" alt=\"Yahoo Finance\" loading=\"eager\">  </a></p> <div> <p>更新于 2026 年 8 月 7 日星期五，美国东部时间上午 8:01 阅读时间 1 分钟</p></div></div>   <div data-testid=\"article-body\">        <p>盈利持续增长，推动股市创出新高。</p>        <p>周五，Vistra Corp. (VST)、Take-Two Interactive Software (TTWO)、Oklo (OKLO)、Under Armour (UA) 和 Wendy's (WEN) 发布报告，为繁忙的一周报告画上句号。</p>        <p>总体而言，标准普尔 500 指数 (^GSPC) 即将迎来强劲的财报季。 根据 FactSet 数据，分析师预计标普 500 指数第二季度盈利同比增长率将为 47.5%，大幅超过 16.4% 的五年平均水平和 10.3% 的 10 年平均水平。</p>        <p>如果这种情况成立，这将标志着该指数连续第二个季度盈利增长超过 20%，并且连续第七个季度实现两位数增长。</p>          </div> <span> </span> </article>      </div></div>"}