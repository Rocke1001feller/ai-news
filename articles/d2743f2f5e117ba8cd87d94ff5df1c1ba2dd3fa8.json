zM28 27h1v1h-1zM29 27h1v1h-1zM30 27h1v1h-1zM2 28h1v1h-1zM4 28h1v1h-1zM5 28h1v1h-1zM6 28h1v1h-1zM8 28h1v1h-1zM10 28h1v1h-1zM11 28h1v1h-1zM12 28h1v1h-1zM13 28h1v1h-1zM14 28h1v1h-1zM15 28h1v1h-1zM20 28h1v1h-1zM21 28h1v1h-1zM22 28h1v1h-1zM23 28h1v1h-1zM25 28h1v1h-1zM26 28h1v1h-1zM27 28h1v1h-1zM30 28h1v1h-1zM2 29h1v1h-1zM8 29h1v1h-1zM13 29h1v1h-1zM16 29h1v1h-1zM18 29h1v1h-1zM19 29h1v1h-1zM20 29h1v1h-1zM21 29h1v1h-1zM22 29h1v1h-1zM23 29h1v1h-1zM24 29h1v1h-1zM26 29h1v1h-1zM29 29h1v1h-1zM2 30h1v1h-1zM3 30h1v1h-1zM4 30h1v1h-1zM5 30h1v1h-1zM6 30h1v1h-1zM7 30h1v1h-1zM8 30h1v1h-1zM10 30h1v1h-1zM11 30h1v1h-1zM12 30h1v1h-1zM14 30h1v1h-1zM15 30h1v1h-1zM16 30h1v1h-1zM17 30h1v1h-1zM18 30h1v1h-1zM19 30h1v1h-1zM20 30h1v1h-1zM21 30h1v1h-1zM22 30h1v1h-1zM23 30h1v1h-1zM24 30h1v1h-1zM25 30h1v1h-1zM26 30h1v1h-1zM27 30h1v1h-1zM29 30h1v1h-1zM30 30h1v1h-1z\" fill=\"#000\" /></svg><p><span data-i=\"qr\">Opened this on a computer? Point your old phone camera here.</span></p></div></div>\n\n<div>\n  <p data-i=\"p3\">We are all different - square, round, scary.</p>\n  <div>\n    <p><img src=\"img/skin-robot.webp\" alt=\"\" loading=\"lazy\"></p>\n    <p><img src=\"img/skin-dots.webp\" alt=\"\" loading=\"lazy\"></p>\n    <p><img src=\"img/skin-alien.webp\" alt=\"\" loading=\"lazy\"></p>\n    <p><img src=\"img/skin-cartoon.webp\" alt=\"\" loading=\"lazy\"></p>\n    <p><img src=\"img/skin-cat.webp\" alt=\"\" loading=\"lazy\"></p>\n    <p><img src=\"img/skin-catneon.webp\" alt=\"\" loading=\"lazy\"></p>\n  </div>\n</div>\n\n<div>\n  <p data-i=\"p4\">You can wave at us and we will wave back. What is the point? We have no idea.</p>\n  <div>\n    <p><img src=\"img/mood-surprised.webp\" alt=\"\" loading=\"lazy\"></p>\n    <p><img src=\"img/mood-love.webp\" alt=\"\" loading=\"lazy\"></p>\n    <p><img src=\"img/mood-happy.webp\" alt=\"\" loading=\"lazy\"></p>\n  </div>\n</div>\n\n<div>\n  <p data-i=\"p5\">Put us next to your monitor and we will dance when we hear music. Or hang us on your backpack and we will scare crows and cats behind your back, or just blink at everyone around.</p>\n  <div>\n    <p><img src=\"img/mood-laugh.webp\" alt=\"\" loading=\"lazy\"></p>\n    <p><img src=\"img/mood-dizzy.webp\" alt=\"\" loading=\"lazy\"></p>\n  </div>\n</div>\n\n<div>\n    <p data-i=\"p6\">Anyway, it is up to you to decide whether you need us or not.</p>\n    <p><a href=\"app.html\" data-i=\"go\">Start the eyes</a></p><p>Camera and microphone are only used so the eyes can see and hear you. Everything is processed on your own device: no video or sound is sent anywhere or recorded. We also work without a camera and microphone. If you turn on the optional remote, only a small picture of the eyes themselves goes to it.</p>\n  </div>\n\n\n</DIV>","content_text":"Hi, we are R-eyesy Robo-eyes. What do we do? Nothing. We just exist. All we need is a screen and a browser. Start the eyes We can live on a computer, an old phone or a tablet. Opened this on a computer? Point your old phone camera here. We are all different - square, round, scary. You can wave at us and we will wave back. What is the point? We have no idea. Put us next to your monitor and we will dance when we hear music. Or hang us on your backpack and we will scare crows and cats behind your back, or just blink at everyone around. Anyway, it is up to you to decide whether you need us or not. Start the eyesCamera and microphone are only used so the eyes can see and hear you. Everything is processed on your own device: no video or sound is sent anywhere or recorded. We also work without a camera and microphone. If you turn on the optional remote, only a small picture of the eyes themselves goes to it.","fetched_at":"2026-11-08T17:57:04.002Z","ok":true,"blocks":[{"html_en":"<h2 data-i=\"h1\">Hi, we are R-eyesy</h2>","sentences":[{"en":"Hi, we are R-eyesy","zh":null}]},{"html_en":"<p>Robo-eyes.</p>","sentences":[{"en":"Robo-eyes.","zh":null}]},{"html_en":"<p data-i=\"p1\">What do we do? Nothing. We just exist. All we need is a screen and a browser.</p>","sentences":[{"en":"What do we do?","zh":null},{"en":"Nothing.","zh":"没有什么。"},{"en":"We just exist.","zh":null},{"en":"All we need is a screen and a browser.","zh":null}]},{"html_en":"<p><a href=\"app.html\" data-i=\"go\">Start the eyes</a>\n  </p>","sentences":[{"en":"Start the eyes","zh":null}]},{"html_en":"<p data-i=\"p2\">We can live on a computer, an old phone or a tablet.</p>","sentences":[{"en":"We can live on a computer, an old phone or a tablet.","zh":null}]},{"html_en":"<p><span data-i=\"qr\">Opened this on a computer? Point your old phone camera here.</span></p>","sentences":[{"en":"Opened this on a computer?","zh":null},{"en":"Point your old phone camera here.","zh":null}]},{"html_en":"<p data-i=\"p3\">We are all different - square, round, scary.</p>","sentences":[{"en":"We are all different - square, round, scary.","zh":null}]},{"html_en":"<p data-i=\"p4\">You can wave at us and we will wave back. What is the point? We have no idea.</p>","sentences":[{"en":"You can wave at us and we will wave back.","zh":null},{"en":"What is the point?","zh":null},{"en":"We have no idea.","zh":null}]},{"html_en":"<p data-i=\"p5\">Put us next to your monitor and we will dance when we hear music. Or hang us on your backpack and we will scare crows and cats behind your back, or just blink at everyone around.</p>","sentences":[{"en":"Put us next to your monitor and we will dance when we hear music.","zh":null},{"en":"Or hang us on your backpack and we will scare crows and cats behind your back, or just blink at everyone around.","zh":null}]},{"html_en":"<p data-i=\"p6\">Anyway, it is up to you to decide whether you need us or not.</p>","sentences":[{"en":"Anyway, it is up to you to decide whether you need us or not.","zh":null}]},{"html_en":"<p><a href=\"app.html\" data-i=\"go\">Start the eyes</a></p>","sentences":[{"en":"Start the eyes","zh":null}]},{"html_en":"<p>Camera and microphone are only used so the eyes can see and hear you. Everything is processed on your own device: no video or sound is sent anywhere or recorded. We also work without a camera and microphone. If you turn on the optional remote, only a small picture of the eyes themselves goes to it.</p>","sentences":[{"en":"Camera and microphone are only used so the eyes can see and hear you.","zh":null},{"en":"Everything is processed on your own device: no video or sound is sent anywhere or recorded.","zh":null},{"en":"We also work without a camera and microphone.","zh":null},{"en":"If you turn on the optional remote, only a small picture of the eyes themselves goes to it.","zh":null}]}],"translated":true,"content_html_zh":"<div class=\"page\" id=\"readability-page-1\">\n\n\n<div>\n    <h2 data-i=\"h1\">Hi, we are R-eyesy</h2>\n    <p>Robo-eyes.</p>\n    <p data-i=\"p1\">What do we do? 没有什么。 We just exist. All we need is a screen and a browser.</p>\n    <p>Start the eyes</p></div>\n\n<div><p data-i=\"p2\">We can live on a computer, an old phone or a tablet.</p>\n    <div><svg viewBox=\"0 0 33 33\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"QR\"><rect width=\"33\" height=\"33\" fill=\"#fff\" /><path d=\"M2 2h1v1h-1zM3 2h1v1h-1zM4 2h1v1h-1zM5 2h1v1h-1zM6 2h1v1h-1zM7 2h1v1h-1zM8 2h1v1h-1zM11 2h1v1h-1zM13 2h1v1h-1zM14 2h1v1h-1zM15 2h1v1h-1zM16 2h1v1h-1zM17 2h1v1h-1zM19 2h1v1h-1zM20 2h1v1h-1zM21 2h1v1h-1zM22 2h1v1h-1zM24 2h1v1h-1zM25 2h1v1h-1zM26 2h1v1h-1zM27 2h1v1h-1zM28 2h1v1h-1zM29 2h1v1h-1zM30 2h1v1h-1zM2 3h1v1h-1zM8 3h1v1h-1zM10 3h1v1h-1zM11 3h1v1h-1zM15 3h1v1h-1zM16 3h1v1h-1zM17 3h1v1h-1zM20 3h1v1h-1zM21 3h1v1h-1zM22 3h1v1h-1zM24 3h1v1h-1zM30 3h1v1h-1zM2 4h1v1h-1zM4 4h1v1h-1zM5 4h1v1h-1zM6 4h1v1h-1zM8 4h1v1h-1zM11 4h1v1h-1zM12 4h1v1h-1zM13 4h1v1h-1zM24 4h1v1h-1zM26 4h1v1h-1zM27 4h1v1h-1zM28 4h1v1h-1zM30 4h1v1h-1zM2 5h1v1h-1zM4 5h1v1h-1zM5 5h1v1h-1zM6 5h1v1h-1zM8 5h1v1h-1zM11 5h1v1h-1zM12 5h1v1h-1zM13 5h1v1h-1zM14 5h1v1h-1zM16 5h1v1h-1zM17 5h1v1h-1zM18 5h1v1h-1zM20 5h1v1h-1zM24 5h1v1h-1zM26 5h1v1h-1zM27 5h1v1h-1zM28 5h1v1h-