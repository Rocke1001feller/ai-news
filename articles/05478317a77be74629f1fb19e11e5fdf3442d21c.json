26-08-26 11:38:58 +08:00\">3h 50m ago</span> \n                    \n                    <p>grok build + vscode</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        \n    \n    \n\n    \n        \n        \n    \n    \n\n    \n        \n        \n    \n    \n\n    \n        \n        <div id=\"r_18019631\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/9a6c/b769/455659_normal.png?m=1782533936\" alt=\"clemente\" data-uid=\"455659\"></td>\n                <td></td>\n                <td><p><span>39</span></p>\n                    \n                    <strong><a href=\"/member/clemente\">clemente</a></strong> &#160; &#160; &#160;<span title=\"2026-08-26 13:36:05 +08:00\">1h 53m ago</span> \n                    \n                    <p>grok 印度订阅 50 人民币一个月错过了 现在还有类似的嘛啊</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        <div id=\"r_18019818\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/be34/b57e/629620_normal.png?m=1785190241\" alt=\"ninjaJ\" data-uid=\"629620\"></td>\n                <td></td>\n                <td><p><span>40</span></p>\n                    \n                    <strong><a href=\"/member/ninjaJ\">ninjaJ</a></strong> &#160; &#160; &#160;<span title=\"2026-08-26 14:09:34 +08:00\">1h 19m ago</span> \n                    \n                    <p>我用 cursor 里的 grok 模型，说实话我到现在也没搞清楚 cursor 和 grok 到底啥关系</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        \n    \n    \n\n    \n        \n        \n    \n    \n\n    \n        \n        \n    \n    \n\n    \n        \n        \n    \n    \n\n    \n        \n        <div id=\"r_18020221\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/9bab/305c