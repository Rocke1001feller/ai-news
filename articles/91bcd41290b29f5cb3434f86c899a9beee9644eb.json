{"id":"91bcd41290b29f5cb3434f86c899a9beee9644eb","url":"https://transitions.dev/","title":"Transitions.dev: UI transitions for AI agents","site_name":"Info Flow","source":"Hacker News (黑客新闻)","byline":"Transitions.dev","excerpt":"Collection of the most essential UI transitions for web apps. Copy and paste them, or use them with your coding agent via the skill.","content_html":"<DIV class=\"page\" id=\"readability-page-1\"><DIV id=\"main\">\n    <header>\n      \n\n      <!-- Full-screen mobile menu. The backdrop is a sibling so it can\n           cover the whole viewport while the top bar stays on top. -->\n      \n      \n    </header>\n\n    \n\n    <!-- ─── Category filter + sort (Figma 1332:6109) ─────────────\n         Pills filter the card grid by data-cat (Pro filters data-pro);\n         the icon button opens a Newest/Oldest sort menu. Reordering is\n         done with CSS `order`, so card prototypes never move in the DOM\n         and their JS keeps working. -->\n    \n\n    <section id=\"components\" aria-label=\"Transition prototypes\">\n\n      <!-- 1. Card resize -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"1\">\n        \n        \n        \n      </article>\n\n      <!-- 2. Number pop-in -->\n      <article data-proto-card=\"\" data-cat=\"texts\" data-seq=\"2\">\n        <div>\n            <p><span>6</span><span>5</span><span>.</span><span>7</span><span>8</span></p>\n          </div>\n        \n        \n      </article>\n\n      <!-- 3. Notification badge -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"3\">\n        \n        \n        \n      </article>\n\n      <!-- 4. Text states swap -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"4\">\n        <div>\n          <p><span data-proto-text=\"\">Transaction processing...</span>\n          </p>\n          </div>\n        \n        \n      </article>\n\n      <!-- 5. Menu dropdown -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"5\">\n        \n        \n        \n      </article>\n\n      <!-- 6. Confetti burst (Pro) -->\n      <article data-proto-card=\"\" data-cat=\"effects\" data-seq=\"28\" data-pro=\"true\" data-pro-id=\"confetti-burst\">\n        \n        \n        \n      </article>\n\n      <!-- 7. Modal open/close -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"6\">\n        \n        \n        \n      </article>\n\n      <!-- 8. Panel reveal -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"7\">\n        \n        \n        \n      </article>\n<!-- 33. Gooey plus menu (Pro) -->\n      <article data-proto-card=\"\" data-cat=\"effects\" data-seq=\"29\" data-pro=\"true\" data-pro-id=\"gooey-plus-menu\">\n        \n        \n        \n      </article>\n\n      <!-- 9. Side-by-side page slide -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"8\">\n        <div data-proto-p8=\"\" data-page=\"1\">\n                    <p>$10</p>\n                    <div>\n                      <p>25%</p>\n                      <p>50%</p>\n                      <p>Max</p>\n                    </div>\n                    <p>$66.11 available</p>\n                  </div>\n        \n        \n      </article>\n\n      <!-- 10. Icon swap -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"9\">\n        \n        \n        \n      </article>\n\n      <!-- 11. Success check -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"10\">\n        \n        \n        \n      </article>\n\n      <!-- 12. Avatar group hover spring -->\n      <article data-proto-card=\"\" data-cat=\"effects\" data-seq=\"11\">\n        <div data-proto-avatars=\"\">\n              <p><img src=\"assets/avatars/avatar-1.webp\" alt=\"\" width=\"32\" height=\"32\" loading=\"lazy\" decoding=\"async\">\n              </p>\n              <p><img src=\"assets/avatars/avatar-2.webp\" alt=\"\" width=\"32\" height=\"32\" loading=\"lazy\" decoding=\"async\">\n              </p>\n              <p><img src=\"assets/avatars/avatar-3.webp\" alt=\"\" width=\"32\" height=\"32\" loading=\"lazy\" decoding=\"async\">\n              </p>\n              <p><img src=\"assets/avatars/avatar-4.webp\" alt=\"\" width=\"32\" height=\"32\" loading=\"lazy\" decoding=\"async\">\n              </p>\n              <p><img src=\"assets/avatars/avatar-5.webp\" alt=\"\" width=\"32\" height=\"32\" loading=\"lazy\" decoding=\"async\">\n              </p>\n              <p><img src=\"assets/avatars/avatar-6.webp\" alt=\"\" width=\"32\" height=\"32\" loading=\"lazy\" decoding=\"async\">\n              </p>\n              <p>+2</p>\n            </div>\n        \n        \n      </article>\n\n      <!-- 13. Card stack hover (Pro) -->\n      <article data-proto-card=\"\" data-cat=\"effects\" data-seq=\"30\" data-pro=\"true\" data-pro-id=\"card-stack-hover\">\n        \n        \n        \n      </article>\n\n      <!-- 14. Input shake on error -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"12\">\n        <div data-proto-shake=\"\">\n              \n              <p>Please enter a valid email.</p>\n            </div>\n        \n        \n      </article>\n\n      <!-- 15. Input clear with dissolve -->\n      <article data-proto-card=\"\" data-cat=\"effects\" data-seq=\"13\">\n        \n        \n        \n      </article>\n\n      <!-- 16. Skeleton loader and reveal -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"14\">\n        <div data-proto-skeleton=\"\">\n                <p><img src=\"assets/avatars/avatar-1.webp\" alt=\"\" width=\"32\" height=\"32\" loading=\"lazy\" decoding=\"async\"></p>\n              </div>\n        \n        \n      </article>\n\n      <!-- 17. Texts reveal -->\n      <article data-proto-card=\"\" data-cat=\"texts\" data-seq=\"15\">\n        <div>\n            <p><strong>Pull request opened</strong>\n              <span>Review requested from 3 teammates</span>\n            </p>\n          </div>\n        \n        \n      </article>\n\n      <!-- 18. Tabs sliding -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"16\">\n        \n        \n        \n      </article>\n<!-- 34. Drag &amp; drop with physics (Pro) -->\n      <article data-proto-card=\"\" data-cat=\"effects\" data-seq=\"31\" data-pro=\"true\" data-pro-id=\"drag-drop-physics\">\n        <div>\n              <p><img alt=\"\" src=\"assets/proto-images/Screenshot%202026-05-17%20at%2019.53.15.png\" draggable=\"false\">\n              </p>\n              <div id=\"pv58\">\n                <p><span>Drag &amp; drop<br>it here</span>\n                <img id=\"pv4b\" alt=\"\" src=\"assets/proto-images/Screenshot%202026-05-17%20at%2019.53.15.png\"></p><!-- Smoke as SVG content: the turbulence filter applies to\n                     shapes inside the svg, which WebKit renders correctly\n                     (its displacement bug is CSS url() on HTML content).\n                     One identical path for Chrome / Firefox / Safari. -->\n                \n              </div>\n            </div>\n        \n        \n      </article>\n\n      <!-- 19. Shimmer text -->\n      <article data-proto-card=\"\" data-cat=\"texts ai\" data-seq=\"17\">\n        <div>\n          <p><span data-proto-shimmer=\"\" data-text=\"Planning next moves\">Planning next moves</span>\n          </p>\n          </div>\n        \n        \n      </article>\n\n      <!-- 20. Organic shimmer (Pro) -->\n      <article data-proto-card=\"\" data-cat=\"effects ai\" data-seq=\"32\" data-pro=\"true\" data-pro-id=\"organic-shimmer\">\n        \n        \n        \n      </article>\n\n      <!-- 21. Tooltip open/close -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"18\">\n        \n        \n        \n      </article>\n\n      <!-- 22. Tilt card -->\n      <article data-proto-card=\"\" data-cat=\"effects\" data-seq=\"19\">\n        <div id=\"p19-tilt\">\n                <p><span>Credit</span>\n                  <span>VISA</span>\n                  <span>John Smith</span>\n                  <span>4111 - 1111 - 1111 - 1111</span>\n                </p>\n                \n              </div>\n        \n        \n      </article>\n\n      <!-- 23. Plus → menu morph -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"20\">\n        \n        \n        \n      </article>\n\n      <!-- 24. Accordion expand/collapse -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"21\">\n        \n        \n        \n      </article>\n\n      <!-- 25. Toast open / close -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"22\">\n        \n        \n        \n      </article>\n\n      <!-- 26. Like button: fill + pop + particle burst -->\n      <article data-proto-card=\"\" data-cat=\"effects\" data-seq=\"23\">\n        \n        \n        \n      </article>\n\n      <!-- 27. Image open tilt (Pro) -->\n      <article data-proto-card=\"\" data-cat=\"effects\" data-seq=\"33\" data-pro=\"true\" data-pro-id=\"image-open-tilt\">\n        \n        \n        \n      </article>\n\n      <!-- 28. Learn more hover: chevron shift + spread -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"24\">\n        \n        \n        \n      </article>\n\n      <!-- 29. Checkbox with check path draw -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"25\">\n        <div>\n            <p>\n              <label id=\"p25-label\">Notify me</label>\n            </p>\n          </div>\n        \n        \n      </article>\n<!-- 35. Spinner to check morph (Pro) -->\n      <article data-proto-card=\"\" data-cat=\"ai\" data-seq=\"34\" data-pro=\"true\" data-pro-id=\"spinner-check-morph\">\n        <div>\n            <p><span id=\"pv3p\">\n              <span id=\"pv4t\" data-state=\"spinning\">\n                \n                \n                \n                \n              </span>\n              </span>\n              <span>\n                <span>Build demo page</span>\n                <span>8 subtasks</span>\n              </span>\n            </p>\n          </div>\n        \n        \n      </article>\n\n      <!-- 30. Spinning reel counter -->\n      <article data-proto-card=\"\" data-cat=\"texts\" data-seq=\"26\">\n        \n        \n        \n      </article>\n\n      <!-- 31. Toggle with double-bounce thumb -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"27\">\n        \n        \n        \n      </article>\n\n      <!-- 32. Pro gradient text (Pro) -->\n      <article data-proto-card=\"\" data-cat=\"texts ai\" data-seq=\"35\" data-pro=\"true\" data-pro-id=\"pro-gradient-text\">\n        <div>\n          <P>\n            <h2><span>Pro</span></h2>\n          </P>\n        </div>\n        \n        \n      </article>\n\n      <!-- 33. Delete image with smoky dissolve (Pro) -->\n      <article data-proto-card=\"\" data-cat=\"effects\" data-seq=\"36\" data-pro=\"true\" data-pro-id=\"smoky-dissolve\">\n        <div>\n            <p><img alt=\"\" src=\"assets/proto-images/Untitled4.jpg\">\n              \n            </p>\n            <!-- Dissolve render target. The old SVG filter pipeline is\n                 CPU-rendered in WebKit and doesn't reliably repaint when\n                 its primitives are animated, so the effect draws here:\n                 tile displacement for the shred, a downscale/upscale\n                 pass for the blur — all GPU-backed drawImage work. -->\n            \n          </div>\n        \n        \n      </article>\n\n      <!-- 34. Thinking states: shimmer + text swap -->\n      <article data-proto-card=\"\" data-cat=\"ai\" data-seq=\"37\">\n        <div>\n          <p><span data-proto-think=\"\" role=\"status\"><span data-text=\"Setting up a workplace\">Setting up a workplace</span></span>\n          </p>\n          </div>\n        \n        \n      </article>\n\n      <!-- 35. Agent reasoning stream -->\n      <article data-proto-card=\"\" data-cat=\"ai\" data-seq=\"38\">\n        \n        \n        \n      </article>\n\n      <!-- 36. Streaming text: word-by-word cross-blur -->\n      <article data-proto-card=\"\" data-cat=\"ai\" data-seq=\"39\">\n        \n        \n        \n      </article>\n\n      <!-- 37. Matrix dot loaders -->\n      <article data-proto-card=\"\" data-cat=\"ai\" data-seq=\"40\">\n        \n        \n        \n      </article>\n\n      <!-- 38. Banner stacking -->\n      <article data-proto-card=\"\" data-cat=\"essential\" data-seq=\"41\">\n        \n        \n        \n      </article>\n\n      <!-- 39. Image generation placeholder (Pro) -->\n      <article data-proto-card=\"\" data-cat=\"ai effects\" data-seq=\"42\" data-pro=\"true\" data-pro-id=\"image-gen-placeholder\">\n        \n        \n        \n      </article>\n\n      <!-- 40. Get Pro button (Pro) -->\n      <article data-proto-card=\"\" data-cat=\"effects\" data-seq=\"43\" data-pro=\"true\" data-pro-id=\"get-pro-button\">\n        \n        \n        \n      </article>\n\n\n      \n\n      \n\n      \n\n\n    </section>\n\n    <!-- ─── Sponsors (Figma 2332:82735) — homepage only. Card 1 keeps\n         the existing \"Take the course\" pill (external-link icon with a\n         static frame + arrow group that leans up-right on hover). -->\n    \n\n    \n  </DIV></DIV>","content_text":"65.78 Transaction processing... $10 25% 50% Max $66.11 available +2 Please enter a valid email. Pull request opened Review requested from 3 teammates Drag & dropit here Planning next moves Credit VISA John Smith 4111 - 1111 - 1111 - 1111 Notify me Build demo page 8 subtasks Pro Setting up a workplace","fetched_at":"2026-09-15T14:13:52.446Z","ok":true,"blocks":[{"html_en":"<p><span>6</span><span>5</span><span>.</span><span>7</span><span>8</span></p>","sentences":[]},{"html_en":"<p><span data-proto-text=\"\">Transaction processing...</span>\n          </p>","sentences":[{"en":"Transaction processing...","zh":null}]},{"html_en":"<p>$10</p>","sentences":[]},{"html_en":"<p>25%</p>","sentences":[]},{"html_en":"<p>50%</p>","sentences":[]},{"html_en":"<p>Max</p>","sentences":[]},{"html_en":"<p>$66.11 available</p>","sentences":[{"en":"$66.11 available","zh":null}]},{"html_en":"<p>+2</p>","sentences":[]},{"html_en":"<p>Please enter a valid email.</p>","sentences":[{"en":"Please enter a valid email.","zh":null}]},{"html_en":"<p><strong>Pull request opened</strong>\n              <span>Review requested from 3 teammates</span>\n            </p>","sentences":[{"en":"Pull request opened Review requested from 3 teammates","zh":null}]},{"html_en":"<p><span>Drag &amp; drop<br>it here</span>\n                <img id=\"pv4b\" alt=\"\" src=\"assets/proto-images/Screenshot%202026-05-17%20at%2019.53.15.png\"></p>","sentences":[{"en":"Drag & dropit here","zh":null}]},{"html_en":"<p><span data-proto-shimmer=\"\" data-text=\"Planning next moves\">Planning next moves</span>\n          </p>","sentences":[{"en":"Planning next moves","zh":null}]},{"html_en":"<p><span>Credit</span>\n                  <span>VISA</span>\n                  <span>John Smith</span>\n                  <span>4111 - 1111 - 1111 - 1111</span>\n                </p>","sentences":[{"en":"Credit VISA John Smith 4111 - 1111 - 1111 - 1111","zh":null}]},{"html_en":"<p>\n              <label id=\"p25-label\">Notify me</label>\n            </p>","sentences":[{"en":"Notify me","zh":null}]},{"html_en":"<p><span id=\"pv3p\">\n              <span id=\"pv4t\" data-state=\"spinning\">\n                \n                \n                \n                \n              </span>\n              </span>\n              <span>\n                <span>Build demo page</span>\n                <span>8 subtasks</span>\n              </span>\n            </p>","sentences":[{"en":"Build demo page 8 subtasks","zh":null}]},{"html_en":"<h2><span>Pro</span></h2>","sentences":[]},{"html_en":"<p><span data-proto-think=\"\" role=\"status\"><span data-text=\"Setting up a workplace\">Setting up a workplace</span></span>\n          </p>","sentences":[{"en":"Setting up a workplace","zh":null}]}],"translated":false}