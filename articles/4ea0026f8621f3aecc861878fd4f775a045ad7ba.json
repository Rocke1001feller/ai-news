03_normal.png?m=1645284917\" alt=\"kindjeff\" data-uid=\"134303\"></td>\n                <td></td>\n                <td>\n                    <div>\n                    \n                    <p><span>21</span></p>\n                    </div>\n                    \n                    <p>5.6 也没觉得多好，早已厌倦 codex 的智商、速度、额度不稳定</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        <div id=\"r_18273669\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/b3e7/d3c6/642412_normal.png?m=1776132421\" alt=\"yuanwenpu00\" data-uid=\"642412\"></td>\n                <td></td>\n                <td>\n                    <div>\n                    \n                    <p><span>22</span></p>\n                    </div>\n                    \n                    <p>用的 6.1 terra 感觉还行。plus 用来编码刚刚够工作使用。</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        <div id=\"r_18273765\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/gravatar/8c5da45ba9225627286273ac356cea10?s=48&d=retro\" alt=\"tanrenye\" data-uid=\"453355\"></td>\n                <td></td>\n                <td>\n                    <div>\n                    \n                    <p><span>23</span></p>\n                    </div>\n                    \n                    <p>没有，现在写出来的代码 bug 明显越来越少了，至于代码啰嗦，已不再关注</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        <div id=\"r_18273989\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/6932/f315/443031_normal.png?m=1756988094\" alt=\"Mandelo\" data-uid=\"443031\"></td>\n                <td></td>\n                <td>\n                    <div>\n                    \n                    <p><span>24</span></p>\n                  