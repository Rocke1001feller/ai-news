                                                                       <a href=\"/author/rahul-naskar/\">\n                                    <picture>\n                                        <source media=\"(max-width: 480px)\" srcset=\"https://static0.anpoimages.com/wordpress%2Fwp-content%2Fauthors%2F69cd4b31b89f4-WhatsApp%20Image%202026-04-01%20at%2010.11.24%20PM.jpeg?fit=crop&w=36&h=36\" width=\"36\" height=\"36\">\n                                        <img src=\"https://static0.anpoimages.com/wordpress%2Fwp-content%2Fauthors%2F69cd4b31b89f4-WhatsApp%20Image%202026-04-01%20at%2010.11.24%20PM.jpeg?fit=crop&w=90&h=90\" alt=\"4\" loading=\"lazy\" decoding=\"async\" width=\"90\" height=\"90\">\n                                    </picture>\n                                </a>\n                                                    </div>\n                        <div>\n                                                                                \n                                    \n                \n                                                                                                                                    <p><time datetime=\"2026-08-10T05:21:03Z\"><span>Published</span> Aug 10, 2026, 1:21 AM EDT</time>\n                        </p>\n                                    \n                                \n                \n            </div>\n                                            \n                                \n                                    \n                            \n        </div>\n\n\n            <a id=\"login-button-article-sidebar\">\n            <p>Sign in to your <span>Android Police</span> account</p>\n            \n        </a>\n                \n                        \n            \n                                                            \n                                            \n                \n                \n                \n            \n            \n\n        \n                        \n        \n                                                                                            \n                        \n\n        \n        \n                                                                \n                        \n                        \n                                    \n        \n                \n                    \n                                                                                                                                                                                                                                                    \n                                                                                    \n                    \n                        \n    \n    \n    \n        \n    \n\n    \n        \n                        \n        \n        \n                        \n\n                                                                        \n                                    \n        \n                                                \n                                                                                                        \n                        \n                                    \n        \n                \n                    \n                                                                                                                                                                                                                                                    \n                                                                                    \n                    \n                        \n    \n    \n    \n        \n    \n\n    \n        \n                        \n        \n        \n                        \n\n        \n        \n                                                \n                        \n                        \n                                    \n        \n                \n                    \n                                                                                                                                                                                                                                                    \n                                                                                    \n                    \n                        \n    \n    \n    \n        \n    \n\n    \n        \n                        \n        \n        \n                        \n\n        \n        \n                                                \n                        \n                        \n                                    \n        \n                \n                    \n                                                                                                                                                                                                                                                    \n                                                                                    \n                    \n                        \n    \n    \n    \n        \n    \n\n    \n        \n                        \n        \n        \n                        \n\n        \n        \n                                        \n                \n                    \n                                                                                                                                                                                                                                                    \n                                                \n                    \n                        \n    \n    \n    \n        \n    \n\n    \n        \n                        \n        \n        \n                        \n\n        \n        \n                                                \n                        \n                                                    \n                                    \n        \n                \n                    \n                                                                                                                                                                                                                                                    \n                                                                                    \n                    \n                                                        \n    \n    \n    \n        \n    \n\n    \n        \n                        \n        \n        \n                        \n\n        \n        \n                                                                                                \n        \n                \n                    \n                                                                                                                                                                                                                                                    \n                                                \n                    \n                        \n    \n    \n    \n        \n    \n\n    \n        \n                        \n        \n        \n                        \n\n        \n        \n                                                \n                        \n                        \n                                    \n        \n                \n                    \n                                                                                                                                                                                                                                                    \n                                                                                    \n                    \n                        \n    \n    \n    \n        \n    \n\n    \n        \n                        \n        \n        \n                        \n\n        \n        \n                                                \n                        \n                        \n                                    \n        \n                \n                    \n                                                                                                                                                                                                                                                    \n                                                                                                                                                                \n                    \n                        \n    \n    \n    \n        \n    \n\n    \n        \n                        \n        \n        \n                        \n\n        \n        \n                                                \n                        \n                        \n                                    \n        \n                \n                    \n                                                                                                                                                                                                                                                    \n                                                                                    \n                    \n                        \n    \n    \n    \n        \n    \n\n    \n        \n                        \n        \n        \n                        \n\n        \n        \n                                                \n                        \n                        \n                                    \n        \n                \n                    \n                                                                                                                                                                                                                                                    \n                                                                                    \n                    \n                        \n    \n    \n    \n        \n    \n\n    \n        \n                        \n        \n        \n                        \n\n        \n        \n        \n                \n                    \n                                                                                                                                                                                                                                                    \n                                                \n                    \n                    \n    \n    \n        \n                \n                    \n                                    \n\n\n\t\t\n\n\n\n\n                                        <!-- No AdsNinja v10 Client! --><!-- No AdsNinja v10 Client! --><!-- No AdsNinja v10 Client! --><!-- No AdsNinja v10 Client! -->\n\n                \n<div itemprop=\"articleBody\" id=\"article-body\"><p>It started as an experimental project inside Google Labs and went on to become one of Google's most popular AI products. It became big enough that Google changed its official name from <a href=\"https://www.androidpolice.com/google-killing-notebooklm-name-in-favor-of-gemini/\" target=\"_blank\">NotebookLM to Gemini Notebook</a> to benefit the Gemini brand.</p>    <!-- No AdsNinja v10 Client! --><!-- No AdsNinja v10 Client! --><p>There has been no significant change in the notebook experience following the rebranding exercise, but the Mountain View tech giant keeps working on new ideas to improve the overall experience. The latest one we just heard is perhaps worth labeling one of the most significant changes since its debut.</p>    <p><a href=\"https://www.testingcatalog.com/google-is-working-on-interactive-apps-for-gemini-notebook/\" rel=\"noopener noreferrer\" target=\"_blank\">Testingcatalog</a> has discovered a new tile called \"App\" in the Studio panel, and as per the description Google has given, it can help you create an app based on source materials.</p>    <p>Testingcatalog has also given us a screenshot of the feature, and based on what we see, it'll accept prompts from users to generate apps. For example, users will be able to create a fun game or a visual dashboard simply by typing that in the text field and hitting the Generate button.</p>    \n                \n    \n    \n    \n                \n    \n                \n                \n                \n        \n                                                            \n                                                                                                                        \n                            \n    \n    \n\n    \n    <div data-img-url=\"https://static0.anpoimages.com/wordpress/wp-content/uploads/2026/08/app-tile-gemini-notebook.jpg\" data-modal-id=\"single-image-modal\" data-modal-container-id=\"single-image-modal-container\" data-img-caption=\"&quot;Testingcatalog&quot;\">\n                                                                                            <figure><picture><source media=\"(max-width: 480px)\" data-srcset=\"https://static0.anpoimages.com/wordpress/wp-content/uploads/2026/08/app-tile-gemini-notebook.jpg?q=49&fit=crop&w=500&dpr=2\" srcset=\"https://static0.anpoimages.com/wordpress/wp-content/uploads/2026/08/app-tile-gemini-notebook.jpg?q=49&fit=crop&w=500&dpr=2\">\n        <source media=\"(max-width: 767px)\" data-srcset=\"https://static0.anpoimages.com/wordpress/wp-content/uploads/2026/08/app-tile-gemini-notebook.jpg?q=49&fit=crop&w=800&dpr=2\" srcset=\"https://static0.anpoimages.com/wordpress/wp-content/uploads/2026/08/app-tile-gemini-notebook.jpg?q=49&fit=crop&w=800&dpr=2\">\n        <source media=\"(max-width: 1023px)\" data-srcset=\"https://static0.anpoimages.com/wordpress/wp-content/uploads/2026/08/app-tile-gemini-notebook.jpg?q=49&fit=crop&w=825&dpr=2\" srcset=\"https://static0.anpoimages.com/wordpress/wp-content/uploads/2026/08/app-tile-gemini-notebook.jpg?q=49&fit=crop&w=825&dpr=2\">\n        <img width=\"1650\" height=\"928\" loading=\"lazy\" decoding=\"async\" alt=\"App-tile-Gemini-notebook\" data-img-url=\"https://static0.anpoimages.com/wordpress/wp-content/uploads/2026/08/app-tile-gemini-notebook.jpg?q=49&fit=crop&w=825&dpr=2\" src=\"https://static0.anpoimages.com/wordpress/wp-content/uploads/2026/08/app-tile-gemini-notebook.jpg?q=49&fit=crop&w=825&dpr=2\">\n        </picture><small>Credit:&#160;Testingcatalog</small></figure>\n            \n        </div>\n<p>Although there is no clear evidence, this will likely be available only for its <a href=\"https://www.androidpolice.com/notebooklm-enters-its-ultra-era-for-power-users/\" target=\"_blank\">Premium tier</a>. Even if Google indeed plans to put it behind a paywall, there is no clarity as to when the \"App\" tile will be available for users.</p>    <!-- No AdsNinja v10 Client! --><h2 id=\"gemini-notebook-is-working-on-two-additional-new-features\">\n                        Gemini Notebook is working on two additional new features\n               </h2>\n<p>In addition to the \"App\" tile, Gemini Notebook was spotted working on a button to allow users to add a note manually. Plus, there is another feature to allow AI to generate a note for users.</p>    <p>These two should complement each other well. While the AI-drafted notes will quickly turn sources into useful notes, the ability <a href=\"https://www.androidpolice.com/started-using-gemini-to-create-notes-in-google-keep/\" target=\"_blank\">to create your own notes</a> gives you more control, as you can manually add changes if need be.</p>    \n\n                \n<p>Moreover, a watermarking toggle is also in the works. There is not enough information on what it does exactly, but it appears to have been designed to allow users to control whether AI-generated branding appears on exported videos, slide decks, and infographics.</p>    <p>Again, there is no clarity over when Google will roll out these features. However, the leak strongly suggests that the company may be in the final stages of development. If that's the case, we can expect all these features to become available for users sooner rather than later.</p>    \n    \n    \n    \n</div>\n    \n    \n        \n                        \n                \n        \n        \n\n                    \n                        \n    \n\n\n            \n                                \n        \n        \n    \n\n        \n    </article>\n\n    \n            \n        </DIV></DIV>","content_text":"Published Aug 10, 2026, 1:21 AM EDT Sign in to your Android Police account It started as an experimental project inside Google Labs and went on to become one of Google's most popular AI products. It became big enough that Google changed its official name from NotebookLM to Gemini Notebook to benefit the Gemini brand. There has been no significant change in the notebook experience following the rebranding exercise, but the Mountain View tech giant keeps working on new ideas to improve the overall experience. The latest one we just heard is perhaps worth labeling one of the most significant changes since its debut. Testingcatalog has discovered a new tile called \"App\" in the Studio panel, and as per the description Google has given, it can help you create an app based on source materials. Testingcatalog has also given us a screenshot of the feature, and based on what we see, it'll accept prompts from users to generate apps. For example, users will be able to create a fun game or a visual dashboard simply by typing that in the text field and hitting the Generate button. Credit: Testingcatalog Although there is no clear evidence, this will likely be available only for its Premium tier. Even if Google indeed plans to put it behind a paywall, there is no clarity as to when the \"App\" tile will be available for users. Gemini Notebook is working on two additional new features In addition to the \"App\" tile, Gemini Notebook was spotted working on a button to allow users to add a note manually. Plus, there is another feature to allow AI to generate a note for users. These two should complement each other well. While the AI-drafted notes will quickly turn sources into useful notes, the ability to create your own notes gives you more control, as you can manually add changes if need be. Moreover, a watermarking toggle is also in the works. There is not enough information on what it does exactly, but it appears to have been designed to allow users to control whether AI-generated branding appears on exported videos, slide decks, and infographics. Again, there is no clarity over when Google will roll out these features. However, the leak strongly suggests that the company may be in the final stages of development. If that's the case, we can expect all these features to become available for users sooner rather than later.","fetched_at":"2026-08-11T06:23:22.527Z","ok":true,"blocks":[{"html_en":"<p><time datetime=\"2026-08-10T05:21:03Z\"><span>Published</span> Aug 10, 2026, 1:21 AM EDT</time>\n                        </p>","sentences":[{"en":"Published Aug 10, 2026, 1:21 AM EDT","zh":"发布于 2026 年 8 月 10 日，美国东部时间凌晨 1:21"}]},{"html_en":"<p>Sign in to your <span>Android Police</span> account</p>","sentences":[{"en":"Sign in to your Android Police account","zh":"登录您的 Android Police 帐户"}]},{"html_en":"<p>It started as an experimental project inside Google Labs and went on to become one of Google's most popular AI products. It became big enough that Google changed its official name from <a href=\"https://www.androidpolice.com/google-killing-notebooklm-name-in-favor-of-gemini/\" target=\"_blank\">NotebookLM to Gemini Notebook</a> to benefit the Gemini brand.</p>","sentences":[{"en":"It started as an experimental project inside Google Labs and went on to become one of Google's most popular AI products.","zh":"它最初是谷歌实验室内的一个实验项目，后来成为谷歌最受欢迎的人工智能产品之一。"},{"en":"It became big enough that Google changed its official name from NotebookLM to Gemini Notebook to benefit the Gemini brand.","zh":"它变得足够大，以至于 Google 将其官方名称从 NotebookLM 更改为 Gemini Notebook，以使 Gemini 品牌受益。"}]},{"html_en":"<p>There has been no significant change in the notebook experience following the rebranding exercise, but the Mountain View tech giant keeps working on new ideas to improve the overall experience. The latest one we just heard is perhaps worth labeling one of the most significant changes since its debut.</p>","sentences":[{"en":"There has been no significant change in the notebook experience following the rebranding exercise, but the Mountain View tech giant keeps working on new ideas to improve the overall experience.","zh":"品牌重塑后，笔记本电脑的体验没有发生重大变化，但这家山景城科技巨头不断致力于新的想法来改善整体体验。"},{"en":"The latest one we just heard is perhaps worth labeling one of the most significant changes since its debut.","zh":"我们刚刚听到的最新消息也许值得标记为自首次亮相以来最重大的变化之一。"}]},{"html_en":"<p><a href=\"https://www.testingcatalog.com/google-is-working-on-interactive-apps-for-gemini-notebook/\" rel=\"noopener noreferrer\" target=\"_blank\">Testingcatalog</a> has discovered a new tile called \"App\" in the Studio panel, and as per the description Google has given, it can help you create an app based on source materials.</p>","sentences":[{"en":"Testingcatalog has discovered a new tile called \"App\" in the Studio panel, and as per the description Google has given, it can help you create an app based on source materials.","zh":"Testcatalog 在 Studio 面板中发现了一个名为“App”的新图块，根据 Google 给出的描述，它可以帮助您根据源材料创建应用程序。"}]},{"html_en":"<p>Testingcatalog has also given us a screenshot of the feature, and based on what we see, it'll accept prompts from users to generate apps. For example, users will be able to create a fun game or a visual dashboard simply by typing that in the text field and hitting the Generate button.</p>","sentences":[{"en":"Testingcatalog has also given us a screenshot of the feature, and based on what we see, it'll accept prompts from users to generate apps.","zh":"Testcatalog 还为我们提供了该功能的屏幕截图，根据我们所看到的内容，它将接受用户的提示来生成应用程序。"},{"en":"For example, users will be able to create a fun game or a visual dashboard simply by typing that in the text field and hitting the Generate button.","zh":"例如，用户只需在文本字段中输入内容并点击“生成”按钮即可创建有趣的游戏或可视化仪表板。"}]},{"html_en":"<p>Although there is no clear evidence, this will likely be available only for its <a href=\"https://www.androidpolice.com/notebooklm-enters-its-ultra-era-for-power-users/\" target=\"_blank\">Premium tier</a>. Even if Google indeed plans to put it behind a paywall, there is no clarity as to when the \"App\" tile will be available for users.</p>","sentences":[{"en":"Although there is no clear evidence, this will likely be available only for its Premium tier.","zh":"尽管没有明确的证据，但这可能仅适用于其高级级别。"},{"en":"Even if Google indeed plans to put it behind a paywall, there is no clarity as to when the \"App\" tile will be available for users.","zh":"即使谷歌确实计划将其置于付费墙后面，也不清楚“应用程序”图块何时可供用户使用。"}]},{"html_en":"<h2 id=\"gemini-notebook-is-working-on-two-additional-new-features\">\n                        Gemini Notebook is working on two additional new features\n               </h2>","sentences":[{"en":"Gemini Notebook is working on two additional new features","zh":"Gemini Notebook 正在开发另外两项新功能"}]},{"html_en":"<p>In addition to the \"App\" tile, Gemini Notebook was spotted working on a button to allow users to add a note manually. Plus, there is another feature to allow AI to generate a note for users.</p>","sentences":[{"en":"In addition to the \"App\" tile, Gemini Notebook was spotted working on a button to allow users to add a note manually.","zh":"除了“应用程序”磁贴之外，Gemini Notebook 还被发现正在开发一个按钮，允许用户手动添加注释。"},{"en":"Plus, there is another feature to allow AI to generate a note for users.","zh":"另外，还有另一个功能可以让人工智能为用户生成注释。"}]},{"html_en":"<p>These two should complement each other well. While the AI-drafted notes will quickly turn sources into useful notes, the ability <a href=\"https://www.androidpolice.com/started-using-gemini-to-create-notes-in-google-keep/\" target=\"_blank\">to create your own notes</a> gives you more control, as you can manually add changes if need be.</p>","sentences":[{"en":"These two should complement each other well.","zh":"这两者应该能够很好地互补。"},{"en":"While the AI-drafted notes will quickly turn sources into useful notes, the ability to create your own notes gives you more control, as you can manually add changes if need be.","zh":"虽然人工智能起草的笔记可以快速将来源转化为有用的笔记，但创建自己的笔记的能力可以为您提供更多控制权，因为您可以根据需要手动添加更改。"}]},{"html_en":"<p>Moreover, a watermarking toggle is also in the works. There is not enough information on what it does exactly, but it appears to have been designed to allow users to control whether AI-generated branding appears on exported videos, slide decks, and infographics.</p>","sentences":[{"en":"Moreover, a watermarking toggle is also in the works.","zh":"此外，水印切换功能也在开发中。"},{"en":"There is not enough information on what it does exactly, but it appears to have been designed to allow users to control whether AI-generated branding appears on exported videos, slide decks, and infographics.","zh":"目前还没有足够的信息说明它的具体用途，但它的设计似乎是为了让用户控制人工智能生成的品牌是否出现在导出的视频、幻灯片和信息图表上。"}]},{"html_en":"<p>Again, there is no clarity over when Google will roll out these features. However, the leak strongly suggests that the company may be in the final stages of development. If that's the case, we can expect all these features to become available for users sooner rather than later.</p>","sentences":[{"en":"Again, there is no clarity over when Google will roll out these features.","zh":"同样，谷歌何时推出这些功能尚不清楚。"},{"en":"However, the leak strongly suggests that the company may be in the final stages of development.","zh":"然而，泄密事件强烈表明该公司可能正处于开发的最后阶段。"},{"en":"If that's the case, we can expect all these features to become available for users sooner rather than later.","zh":"如果是这样的话，我们可以预期所有这些功能都将很快为用户提供。"}]}],"translated":true,"content_html_zh":"<div class=\"page\" id=\"readability-page-1\"><div>\n\n        \n                                        \n\n\n\n\n            <article>\n\n                            \n\n                                                                                                                                                                                                                                                                                                                                                                                                                            \n    \n    \n    \n    \n        \n                    <header>\n\n            \n            \n            \n                                                \n\n\n    \n                            \n            \n                        \n    \n\n    \n        \n                        \n        \n        \n                        \n\n        \n        \n        \n                \n                    \n                                        \n                                                    \n    \n                    \n                        \n    \n    \n    \n        \n    \n\n    \n        \n                        \n        \n        \n                        \n\n        \n        \n        \n                \n                    \n                                        \n                    \n                        \n    \n    \n    \n        \n    \n\n    \n        \n                        \n        \n        \n                        \n\n        \n        \n        \n                \n                    \n                            \n                                                    \n                                    \n                                                \n            \n    <div data-img-url=\"https://static0.anpoimages.com/wordpress/wp-content/uploads/wm/2026/05/notebooklm-voice-notes-2.jpg\" data-modal-id=\"single-image-modal\" data-modal-container-id=\"single-image-modal-container\" data-img-caption=\"&quot;&quot;\" data-is-feature-img=\"true\">\n        \n    