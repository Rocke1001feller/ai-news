ne\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-astro-cid-ftq3vvlr=\"\"><circle cx=\"11\" cy=\"11\" r=\"8\" data-astro-cid-ftq3vvlr=\"\" /><path d=\"m21 21-4.3-4.3\" data-astro-cid-ftq3vvlr=\"\" /></svg><p><span id=\"searchKbdHint\" data-astro-cid-ftq3vvlr=\"\">/</span></p></div><!-- Cinematic About Me Section --><div id=\"second-page\"><!-- Card 1: Languages --><div data-speed=\"0.9\"><h3>Languages Spoken</h3><ul><li><span>Fluent</span> <span><span title=\"English\"></span><span title=\"French\"></span><span title=\"Arabic\"></span><span title=\"Moroccan dialect\"></span></span></li><li><span>Learning</span> <span><span title=\"Mandarin\"></span></span></li></ul></div><!-- Card 2: User Reach & Impact --><div data-speed=\"1.1\"><h3>Active Reach</h3><ul><li><span>Chrome Extension</span> <span>1,400+ Active Weekly Users</span></li><li><span>Windows Mod</span> <span>2,700+ Windhawk Mod Users</span></li><li><span>Community Mirrors</span> <span>55,000+ Downloads</span></li></ul></div><!-- Card 3: Development Focus --><div data-speed=\"1.0\"><h3>Engineering Focus</h3><ul><li><span>Specialty</span> <span>Browser Extensions &amp; Custom UI Mods</span></li><li><span>Architecture</span> <span>Astro 5, WebGL, Node REST Proxies</span></li><li><span>Philosophy</span> <span>Privacy-first, Lightweight, Fast UX</span></li></ul></div><!-- Card 4: Google Local Guide Stats --><div data-speed=\"1.2\"><h3>Public Contributions</h3><ul><li><span>Google Local Guide</span> <span>Level 6 (Oct 2021 – Present)</span></li><li><span>Map Views</span> <span>1.6 Million+ Total Views</span></li><li><span>Data Edits</span> <span>190+ Verified Edits &amp; 18 Road Segments</span></li></ul></div></div><!-- Cinematic Activities Section --><!-- Cinematic Activities Section --><div id=\"activities-page\"><!-- Section Title --><!-- Activities Grid --><div><!-- Physical --><div data-tilt=\"\"><p><span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"36