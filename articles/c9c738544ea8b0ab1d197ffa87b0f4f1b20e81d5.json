adMap&quot;:{},&quot;isCut&quot;:false}\" data-lark-record-format=\"docx/text\"></span><span data-mpa-action-id=\"mottit0p1adr\"></span><span data-lark-record-data=\"{&quot;rootId&quot;:&quot;HiT6dR6bqoegBFxS6Ztci0eLn5e&quot;,&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;前Covariant AI 副总裁、舟谱数据CTO慕巍博士出任「枢途科技」CTO。&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+15&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7538706056718925852&quot;]},&quot;nextNum&quot;:1}},&quot;type&quot;:&quot;text&quot;,&quot;referenceRecordMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;isEqualBlockSelection&quot;:false,&quot;pasteRandomId&quot;:&quot;dfd888fd-3d05-41de-99ef-9e50f4d1eda1&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{}},&quot;isKeepQuoteContainer&quot;:false,&quot;isFromCode&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:37,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:3,&quot;end&quot;:44},&quot;recordId&quot;:&quot;HCUjdyERwog1txxNzqYcmirnnBh&quot;}],&quot;payloadMap&quot;:{},&quot;isCut&quot;:false}\" data-lark-record-format=\"docx/text\"></span><span data-mpa-action-id=\"mnzfe1dlmiz\"></span><span data-mpa-action-id=\"mn32l2a062f\"></span><span data-mpa-action-id=\"mmos90171jtf\"></span><span data-lark-record-data=\"{&quot;rootId&quot;:&quot;AzjmduHCvoPVEexzmhKc7S4Enkg&quot;,&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;联创团队刚刚亮相，这家物理AI创业公司的融资与股东阵容也随之浮出水面。&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+z&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7536161670281445404&quot;]},&quot;nextNum&quot;:1}},&quot;type&quot;:&quot;text&quot;,&quot;referenceRecordMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;isEqualBlockSelection&quot;:true,&quot;pasteRandomId&quot;:&quot;3ca65e27-