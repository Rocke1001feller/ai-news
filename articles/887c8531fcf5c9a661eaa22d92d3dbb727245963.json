.net/sJnPsQvdVCKZeS5AMgMii-750-80.jpg 750w, https://cdn.mos.cms.futurecdn.net/sJnPsQvdVCKZeS5AMgMii-650-80.jpg 650w, https://cdn.mos.cms.futurecdn.net/sJnPsQvdVCKZeS5AMgMii-480-80.jpg 480w, https://cdn.mos.cms.futurecdn.net/sJnPsQvdVCKZeS5AMgMii-320-80.jpg 320w\" sizes=\"(min-width: 1000px) 600px, 100vw\" data-new-v2-image=\"true\" data-original-mos=\"https://cdn.mos.cms.futurecdn.net/sJnPsQvdVCKZeS5AMgMii.jpg\" data-pin-media=\"https://cdn.mos.cms.futurecdn.net/sJnPsQvdVCKZeS5AMgMii.jpg\" data-pin-nopin=\"true\" fetchpriority=\"high\" data-component-name=\"Image\">\n</picture>\n<figcaption> <span>(Image credit: Future)</span>\n</figcaption>\n</figure></div>\n<div id=\"article-body\">\n\n<p id=\"elk-85357e20-e988-11f1-84a4-a16f8ad65bf6\">The <a data-analytics-id=\"inline-link\" href=\"https://www.techradar.com/tag/tcl\" data-auto-tag-linker=\"true\" data-url=\"https://www.techradar.com/tag/tcl\" data-hl-processed=\"none\" data-article-category=\"televisions\" data-mrf-recirculation=\"inline-link\" data-before-rewrite-localise=\"https://www.techradar.com/tag/tcl\">TCL</a> QM7L is the best mid-range TV of 2026, and right now you can get the 65-inch version with a whopping 43% price reduction: where the <a data-analytics-id=\"inline-link\" href=\"https://target.georiot.com/Proxy.ashx?tsid=8428&GR_URL=https%3A%2F%2Famazon.com%2Fgp%2Fproduct%2FB0GPT7DGDR%3Fsmid%3DATVPDKIKX0DER%26th%3D1%26tag%3Dftr-techradar-us-20%26ascsubtag%3Dtrd-us-6795647638923881059-20\" data-url=\"https://www.amazon.com/gp/product/B0GPT7DGDR?smid=ATVPDKIKX0DER&th=1\" target=\"_blank\" referrerpolicy=\"no-referrer-when-downgrade\" rel=\"sponsored noopener\" data-hl-processed=\"hawklinks\" data-article-category=\"televisions\" data-google-interstitial=\"false\" data-placeholder-url=\"https://target.georiot.com/Proxy.ashx?tsid=8428&GR_URL=https%3A%2F%2Famazon.com%2Fgp%2Fproduct%2FB0GPT7DGDR%3Fsmid%3DATVPDKIKX0DER%26th%3D1%26tag%3Dftr-techradar-us-20%26ascsubtag%3Dhawk-custom-tracking-20\" data-merchant-name=\"Amazon US\" data-merchant-id=\"1471\" data-merchant-network=\"Amazonus\" data-merchant-url=\"amazon.com\" data-mrf-recirculation=\"inline-link\">TCL QM7L <del>was $1,499.99</del> it is now just $847.99 at Amazon</a>. At full price the TV was a great buy. At this price it's a doorbuster, the kind of saving you'd queue up for.</p><p>• <a data-analytics-id=\"inline-link\" href=\"https://target.georiot.com/Proxy.ashx?tsid=8428&GR_URL=https%3A%2F%2Famazon.com%2Fdeals%3Ftag%3Dftr-techradar-us-20%26ascsubtag%3Dtrd-us-6795647638923881059-20\" data-url=\"https://www.amazon.com/deals\" target=\"_blank\" referrerpolicy=\"no-referrer-when-downgrade\" rel=\"sponsored noopener\" data-hl-processed=\"hawklinks\" data-article-category=\"televisions\" data-google-interstitial=\"false\" data-placeholder-url=\"https://target.georiot.com/Proxy.ashx?tsid=8428&GR_URL=https%3A%2F%2Famazon.com%2Fdeals%3Ftag%3Dftr-techradar-us-20%26ascsubtag%3Dhawk-custom-tracking-20\" data-merchant-name=\"Amazon US\" data-merchant-id=\"1471\" data-merchant-network=\"Amazonus\" data-merchant-url=\"amazon.com\" data-mrf-recirculation=\"inline-link\">Browse the full Amazon Black Friday sale</a></p><p>In our in-depth <a data-analytics-id=\"inline-link\" href=\"https://www.techradar.com/televisions/an-almost-premium-tv-at-mid-range-prices-tcls-qm7l-mini-led-screen-is-one-of-the-best-affordable-sets-ive-tested-thanks-to-its-vibrant-colors-bright-highlights-and-great-gaming-features\" data-url=\"https://www.techradar.com/televisions/an-almost-premium-tv-at-mid-range-prices-tcls-qm7l-mini-led-screen-is-one-of-the-best-affordable-sets-ive-tested-thanks-to-its-vibrant-colors-bright-highlights-and-great-gaming-features\" data-hl-processed=\"none\" data-article-category=\"televisions\" data-mrf-recirculation=\"inline-link\" data-before-rewrite-localise=\"https://www.techradar.com/televisions/an-almost-premium-tv-at-mid-range-prices-tcls-qm7l-mini-led-screen-is-one-of-the-best-affordable-sets-ive-tested-thanks-to-its-vibrant-colors-bright-highlights-and-great-gaming-features\">TCL QM7L review</a> we gave it 4.5 out of five stars, praising its picture quality, its gamer-friendly features (including a high refresh rate and <a data-analytics-id=\"inline-link\" href=\"https://www.techradar.com/tag/amd\" data-auto-tag-linker=\"true\" data-url=\"https://www.techradar.com/tag/amd\" data-hl-processed=\"none\" data-article-category=\"televisions\" data-mrf-recirculation=\"inline-link\" data-before-rewrite-localise=\"https://www.techradar.com/tag/amd\">AMD</a> Freesync Pro) and its excellent value for money.</p><p>As our expert reviewer James Holland explained, the TCL QM7L is \"impressive with up to 2,100 local dimming zones, up to 3,000 nits at peak brightness, TCL’s anti-halo and color enhancing tech, and AI features such as the imperfect generative voice assistant in <a data-analytics-id=\"inline-link\" href=\"https://www.techradar.com/tag/google\" data-url=\"https://www.techradar.com/tag/google\" data-hl-processed=\"none\" data-article-category=\"televisions\" data-mrf-recirculation=\"inline-link\" data-before-rewrite-localise=\"https://www.techradar.com/uk/tag/google\">Google</a> Gemini. The sound is still provided by Bang &amp; Olufsen and the refresh rate (and passthrough from HDMI ports) is high enough that it will make for one of the <a data-analytics-id=\"inline-link\" href=\"https://www.techradar.com/news/best-gaming-tv\" data-url=\"https://www.techradar.com/news/best-gaming-tv\" data-hl-processed=\"none\" data-article-category=\"televisions\" data-mrf-recirculation=\"inline-link\" data-before-rewrite-localise=\"https://www.techradar.com/uk/news/best-gaming-tv\"><u>best gaming TVs</u></a> for those trying to strike a balance between premium performance and price.\"</p><p>We'd quibble very slightly with <a data-analytics-id=\"inline-link\" href=\"https://www.techradar.com/tag/amazon\" data-auto-tag-linker=\"true\" data-url=\"https://www.techradar.com/tag/amazon\" data-hl-processed=\"none\" data-article-category=\"televisions\" data-mrf-recirculation=\"inline-link\" data-before-rewrite-localise=\"https://www.techradar.com/tag/amazon\">Amazon</a>'s RRP here — Amazon says $1,499, but the 65-inch launch price was $1,299 — but this is still a substantial saving on a very good mid-range television that takes the price well into bargain territory.</p><h2 id=\"today-39-s-best-tcl-qm7l-deal-3\">Today's best TCL QM7L deal</h2><h2 id=\"more-black-friday-deals-in-the-us-3\">More Black Friday deals in the US</h2><ul id=\"elk-8535801e-e988-11f1-aaac-ff3e3287913a\"><li><strong>Amazon</strong>: <a href=\"https://target.georiot.com/Proxy.ashx?tsid=8428&GR_URL=https%3A%2F%2Famazon.com%2Fdeals%3Ftag%3Dftr-techradar-us-20%26ascsubtag%3Dtrd-us-6795647638923881059-20\" data-url=\"https://www.amazon.com/deals\" target=\"_blank\" referrerpolicy=\"no-referrer-when-downgrade\" rel=\"sponsored noopener\" data-hl-processed=\"hawklinks\" data-article-category=\"televisions\" data-google-interstitial=\"false\" data-placeholder-url=\"https://target.georiot.com/Proxy.ashx?tsid=8428&GR_URL=https%3A%2F%2Famazon.com%2Fdeals%3Ftag%3Dftr-techradar-us-20%26ascsubtag%3Dhawk-custom-tracking-20\" data-merchant-name=\"Amazon US\" data-merchant-id=\"1471\" data-merchant-network=\"Amazonus\" data-merchant-url=\"amazon.com\">up to 65% off tech &amp; essentials</a></li><li><strong>Best Buy</strong>: <a href=\"https://bestbuy.7tiv.net/c/1943169/614286/10014?subId1=trd-us-3997268287977274827&sharedId=trd-us&u=https%3A%2F%2Fwww.bestbuy.com%2Fblack-friday\" data-url=\"https://www.bestbuy.com/black-friday\" target=\"_blank\" referrerpolicy=\"no-referrer-when-downgrade\" rel=\"sponsored noopener\" data-hl-processed=\"hawklinks\" data-article-category=\"televisions\" data-google-interstitial=\"false\" data-placeholder-url=\"https://bestbuy.7tiv.net/c/1943169/614286/10014?subId1=hawk-custom-tracking&sharedId=hawk-prefix&u=https%3A%2F%2Fwww.bestbuy.com%2Fblack-friday\" data-merchant-nam