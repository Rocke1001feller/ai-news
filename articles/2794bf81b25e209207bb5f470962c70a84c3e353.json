{"id":"2794bf81b25e209207bb5f470962c70a84c3e353","url":"https://www.businessinsider.com/anthropic-claude-internal-ai-use-exceeds-employee-pay-tokens-2026-11","title":"Anthropic's internal AI usage now exceeds employee compensation","site_name":"TechURLs","source":"Business Insider","byline":"Alistair Barr","excerpt":"Anthropic's IPO filing reveals a striking milestone: Its internal AI usage is now valued above employee compensation.","content_html":"<DIV class=\"page\" id=\"readability-page-1\"><section data-content-container=\"\" role=\"main\">\n\n    \n      \n    \n      <div data-load-strategy=\"disable-lazy\" data-component-type=\"post-top\" data-e2e-name=\"post-top\">\n    \n          \n            <section id=\"post-headline\">\n              <h2>Anthropic's internal AI use, valued at retail prices, now exceeds its employee pay</h2>\n          \n            </section>\n            \n            \n            \n              <div data-e2e-name=\"post-byline\" data-component-type=\"post-byline\" data-track-marfeel=\"post-byline\">\n                        <a data-e2e-name=\"byline-author-image\" href=\"https://www.businessinsider.com/author/alistair-barr\">\n                              <div data-slug=\"\">\n                                  <p><img data-old-src=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\" src=\"https://i.insider.com/67e46b3b63d72727e1985905?crop=1:1&width=256&format=jpeg&auto=webp&saturation=-100\" alt=\"Alistair Barr, global tech editor of Business Insider, smiles at the camera while wearing a blue and white striped shirt.\">\n                                \n                                \n                                \n                                </p>  </div>\n                          </a>\n                        <p><span>\n                          <span>\n                            <span>\n                              By   <a href=\"https://www.businessinsider.com/author/alistair-barr\">Alistair Barr</a>\n                      \n                            </span>\n                              \n                        <span data-disable-for-sooth-user=\"\" data-component-type=\"follow-button\" data-load-strategy=\"lazy\" role=\"tooltip\" data-tooltip-position=\"middle\" data-tooltip-active=\"false\" data-state=\"\" data-topic-type=\"author\" data-topic-slug=\"alistair-barr\" data-topic-link=\"https://www.businessinsider.com/author/alistair-barr\" data-topic-label=\"Alistair Barr\" data-topic-location=\"byline\" data-topic-shortened-label=\"Alistair\" data-topic-image=\"{&quot;type&quot;:&quot;image&quot;,&quot;id&quot;:&quot;67e46b3b63d72727e1985905&quot;,&quot;attributes&quot;:{&quot;caption&quot;:&quot;Alistair Barr, global tech editor of Business Insider&quot;,&quot;contentType&quot;:&quot;image/png&quot;,&quot;description&quot;:&quot;Alistair Barr, global tech editor of Business Insider, smiles at the camera while wearing a blue and white striped shirt.&quot;,&quot;height&quot;:1151,&quot;source&quot;:&quot;Business Insider&quot;,&quot;width&quot;:1151},&quot;links&quot;:{&quot;self&quot;:&quot;https://i.insider.com/67e46b3b63d72727e1985905&quot;}}\" data-track-view=\"{&quot;subscription_experience&quot;:&quot;bi_value_unassigned&quot;,&quot;product_field&quot;:&quot;byline&quot;,&quot;element_name&quot;:&quot;follow_author&quot;,&quot;event&quot;:&quot;module_in_view&quot;}\">\n                          \n                        \n                          <div>\n                            <p>\n                                You're currently following this author!\n                         Click to unsubscribe from email alerts.\n                            </p>\n                          </div>\n                          \n                        </span>\n                          </span>\n                          <span>\n                            <p>Author of the <a target=\"_blank\" href=\"https://www.businessinsider.com/subscription/newsletter/ai-insider\" data-autoaffiliated=\"false\">AI Insider</a> newsletter</p>\n                          </span>\n                        </span>\n                      </p></div>\n        </div>\n\n  <section>\n    \n    \n    \n    \n      <section id=\"post-body\" data-component-type=\"post-body\" data-load-strategy=\"exclude\" data-lock-content=\"\">\n            \n            \n            \n              <div data-e2e-name=\"post-hero\" data-component-type=\"post-hero\" data-load-strategy=\"exclude\">\n                    <figure data-type=\"img\" data-e2e-name=\"image-figure-image\" data-media-container=\"image\" itemscope itemtype=\"https://schema.org/ImageObject\">\n                        <div>\n                          <meta itemprop=\"contentUrl\" content=\"https://i.insider.com/6ad003bbe50b02f612be3b08?width=1200\">\n                          <p><img src=\"https://i.insider.com/6ad003bbe50b02f612be3b08?width=700\" srcset=\"https://i.insider.com/6ad003bbe50b02f612be3b08?width=400&format=jpeg&auto=webp 400w, https://i.insider.com/6ad003bbe50b02f612be3b08?width=500&format=jpeg&auto=webp 500w, https://i.insider.com/6ad003bbe50b02f612be3b08?width=700&format=jpeg&auto=webp 700w, https://i.insider.com/6ad003bbe50b02f612be3b08?width=1000&format=jpeg&auto=webp 1000w, https://i.insider.com/6ad003bbe50b02f612be3b08?width=1300&format=jpeg&auto=webp 1300w, https://i.insider.com/6ad003bbe50b02f612be3b08?width=2000&format=jpeg&auto=webp 2000w\" sizes=\"(min-width: 1280px) 900px\" alt=\"Anthropic CEO Dario Amodei.\" decoding=\"sync\">\n                        </p></div>\n                    \n                          <span>\n                              <span>\n                                \n                                <label for=\"caption-drawer-btn\">\n                                          </label>\n                        \n                            <figcaption data-e2e-name=\"image-caption\">\n                              <span>Anthropic CEO Dario Amodei.</span>\n                              <span>\n                                <span data-e2e-name=\"image-source\" itemprop=\"creditText\">Aaron Schwartz/Bloomberg via Getty Images</span>      </span>\n                            </figcaption>\n                          </span>\n                        </span>\n                        \n                    </figure>\n              </div>\n    \n    \n    \n          \n    \n            \n    \n    \n          \n    \n            \n            \n            \n            \n    \n          \n    \n      <section data-load-strategy=\"lazy\" data-component-type=\"image-modal\" data-track-content=\"\" data-post-type=\"story\" data-track-marfeel=\"post-body-content\">\n                \n                    <p>Here's a remarkable milestone in the AI revolution: <a target=\"_self\" href=\"https://www.businessinsider.com/anthropic-ipo-filing-ai-profit-800-billion-compute-risk-2026-10\" data-track-click=\"{&quot;element_name&quot;:&quot;body_link&quot;,&quot;event&quot;:&quot;tout_click&quot;,&quot;index&quot;:&quot;bi_value_unassigned&quot;,&quot;product_field&quot;:&quot;bi_value_unassigned&quot;}\" rel=\"\">Anthropic</a> now spends more on internal <a target=\"_self\" href=\"https://www.businessinsider.com/chatgpt-helped-fix-home-internet-ethernet-cable-zoom\" data-track-click=\"{&quot;element_name&quot;:&quot;body_link&quot;,&quot;event&quot;:&quot;tout_click&quot;,&quot;index&quot;:&quot;bi_value_unassigned&quot;,&quot;product_field&quot;:&quot;bi_value_unassigned&quot;}\" rel=\"\">AI</a> usage than it does paying employees.</p><p>The company revealed this in its <a target=\"_self\" href=\"https://www.businessinsider.com/anthropic-ipo-filing-ai-profit-800-billion-compute-risk-2026-10\" data-track-click=\"{&quot;element_name&quot;:&quot;body_link&quot;,&quot;event&quot;:&quot;tout_click&quot;,&quot;index&quot;:&quot;bi_value_unassigned&quot;,&quot;product_field&quot;:&quot;bi_value_unassigned&quot;}\" rel=\"\">IPO filing</a>. In April, the value of Claude AI used internally, calculated at prices Anthropic charges customers, exceeded its monthly employee compensation costs, excluding stock awards. </p><p>By September, that internal AI usage had surged more than 250-fold since January.</p><p>There's an important distinction here. Anthropic isn't actually spending more cash on AI than salaries. It's valuing its internal AI consumption at retail prices.</p><p>Still, this feels like a watershed moment for the tech industry.</p><p>In March, I wrote about a <a target=\"_self\" href=\"https://www.businessinsider.com/silicon-valley-abuzz-about-adding-ai-compute-to-engineer-compensation-2026-3\" data-track-click=\"{&quot;element_name&quot;:&quot;body_link&quot;,&quot;event&quot;:&quot;tout_click&quot;,&quot;index&quot;:&quot;bi_value_unassigned&quot;,&quot;product_field&quot;:&quot;bi_value_unassigned&quot;}\" rel=\"\">new trend</a>: Tech companies are starting to treat AI tokens (the main way to measure usage) as a fourth component of employee compensation, alongside salary, bonuses, and stock awards.</p><p>Anthropic's numbers show why. More than 90% of the code added to its software in September was written by Claude. Meanwhile, revenue has grown vastly faster than headcount.</p><p>For decades, talented humans were the most valuable resource in Silicon Valley. Now AI is challenging that assumption.</p><p><strong><em>Sign up for the AI Insider newsletter </em></strong><a target=\"_self\" href=\"https://www.businessinsider.com/subscription/newsletter/tech-memo\" data-track-click=\"{&quot;element_name&quot;:&quot;body_link&quot;,&quot;event&quot;:&quot;tout_click&quot;,&quot;index&quot;:&quot;bi_value_unassigned&quot;,&quot;product_field&quot;:&quot;bi_value_unassigned&quot;}\" rel=\"\"><strong><em>here</em></strong></a><strong><em>. Reach out to me via email at </em></strong><a target=\"_blank\" href=\"mailto:abarr@businessinsider.com\" data-track-click=\"{&quot;click_type&quot;:&quot;other&quot;,&quot;element_name&quot;:&quot;body_link&quot;,&quot;event&quot;:&quot;outbound_click&quot;}\" rel=\" nofollow\"><strong><em>abarr@businessinsider.com</em></strong></a></p>\n                \n                \n                </section>\n    \n    \n    \n    \n      </section>\n\n    \n    <!-- Included desktop \"post-aside\" -->    \n\n    \n      \n      <section data-component-type=\"post-bottom\" data-load-strategy=\"exclude\" data-track-marfeel=\"post-bottom\">\n        <section>\n    \n    \n            \n            \n    \n            \n            \n            <section data-component-type=\"read-next\" data-e2e-name=\"read-next\" data-display-size=\"4\" data-post-id=\"6ae500a55b8497898888e682\" data-root-margin=\"250px 0px\" data-track-view=\"{&quot;subscription_experience&quot;:&quot;bi_value_unassigned&quot;,&quot;product_field&quot;:&quot;bi_value_unassigned&quot;,&quot;element_name&quot;:&quot;end_of_article_recirc&quot;}\">\n              <h2>Read next</h2>\n            \n              <div data-track-click-shared=\"{&quot;product_field&quot;:&quot;bi_value_unassigned&quot;,&quot;event&quot;:&quot;tout_click&quot;,&quot;element_name&quot;:&quot;end_of_article_recirc&quot;,&quot;click_text&quot;:&quot;Read next&quot;}\" data-recommendations-content=\"\" data-e2e-name=\"read-next-list\" data-recommendations-list=\"\">\n                    \n                    \n                    \n                    <article data-component-type=\"tout\" data-load-strategy=\"exclude\" data-post-id=\"post\">\n                     \n                          \n                            <span>    <p><img data-src=\"/public/assets/logos/placeholder.png\" data-old-src=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E\" src=\"/public/assets/logos/placeholder.png\" alt=\"\">\n                            \n                            \n                            \n                            </