ttps://cdn.v2ex.com/avatar/d64d/2297/66852_normal.png?m=1789095648\" alt=\"break\" data-uid=\"66852\"></td>\n                <td></td>\n                <td><p><span>2</span></p>\n                    \n                    <strong><a href=\"/member/break\">break</a></strong> &#160; <div><p>OP</p></div>&#160; &#160;<span title=\"2026-10-25 12:26:15 +08:00\">18h 57m ago</span> \n                    \n                    <div><p>吐槽下它现在还要用鼠标点击触发，我的是鼠标划过去触发，更实用～</p><p>然后我的自带下次充值时间提醒，比它更详细，🐶</p></div>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        <div id=\"r_18218405\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/gravatar/cf67a8561d8388e297860e5693c5d2e0?s=48&d=retro\" alt=\"70nY\" data-uid=\"304475\"></td>\n                <td></td>\n                <td><p><span>3</span></p>\n                    \n                    <strong><a href=\"/member/70nY\">70nY</a></strong> &#160; &#160; &#160;<span title=\"2026-10-25 12:38:13 +08:00\">18h 45m ago</span> \n                    \n                    <p>是不是跟 iphone duo 那个信号栏差不多</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        <div id=\"r_18218432\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/gravatar/ec0bf13a481453642ba6a59c0c549b1b?s=48&d=retro\" alt=\"quijote\" data-uid=\"289852\"></td>\n                <td></td>\n                <td><p><span>4</span></p>\n                    \n                    <strong><a href=\"/member/quijote\">quijote</a></strong> &#160; &#160; &#160;<span title=\"2026-10-25 13:13:28 +08:00\">18h 10m ago</span> \n                    \n                    <p>什么,Codex 侧边栏的插件还能自己写呢？</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        \n    \n    \n    \n    \n\n    \n        \n        <div id=\"r_18218466\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/gravatar/daa907248202cd5689f03714b382ddce?s=48&d=retro\" alt=\"win8en\" data-uid=\"195910\"></td>\n                <td></td>\n                <td><p><span>6</span></p>\n                    \n                    <strong><a href=\"/member/win8en\">win8en</a></strong> &#160; &#160; &#160;<span title=\"2026-10-25 13:43:00 +08:00\">17h 40m ago via Android</span> \n                    \n                    <p>可以考虑去 OpenAI 投份简历了</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        <div id=\"r_18218485\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/d64d/2297/66852_normal.png?m=1789095648\" alt=\"break\" data-uid=\"66852\"></td>\n                <td></td>\n                <td><p><span>7</span></p>\n                    \n                    <strong><a href=\"/member/break\">break</a></strong> &#160; <div><p>OP</p></div>&#160; &#160;<span title=\"2026-10-25 14:00:13 +08:00\">17h 23m ago</span> \n                    \n                    <div><p>@<a href=\"/member/70nY\">70nY</a> codex 官方这个设计有点那个感觉，一个圆切成两半，两个功能。我是设计了三层，每层一个功能叠在一起</p><p>@<a href=\"/member/NotLongNil\">NotLongNil</a> 好像要用量到一定程度触发或者什么触发条件，也不太清楚，我两个账号有一个美区账号不显示，一个日区账号显示了</p></div>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        <div id=\"r_18218490\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/748a/7ef3/545059_normal.png?m=1785749810\" alt=\"rxswift\" data-uid=\"545059\"></td>\n                <td></td>\n                <td><p><span>8</span></p>\n                    \n                    <strong><a href=\"/member/rxswift\">rxswift</a></strong> &#160; &#160; &#160;<span title=\"2026-10-25 14:02:55 +08:00\">17h 21m ago</span> \n                    \n                    <p>这不抄袭吗，能不能告 codex</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        <div id=\"r_18218529\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/626d/dccd/62211_normal.png?m=1757171598\" alt=\"TimePPT\" data-uid=\"62211\"></td>\n                <td></td>\n                <td><p><span>9</span></p>\n                    \n                    <strong><a href=\"/member/TimePPT\">TimePPT</a></strong> &#160; &#160; &#160;<span title=\"2026-10-25 14:37:58 +08:00\">16h 45m ago</span> \n                    \n                    <div><p>@<a href=\"/member/rxswift\">rxswift</a> 告别家 UI/UX 抄袭需要专利申请的。没记错的话抽象的纯 UI/UX 都是没法申请专利的，脱离具体软硬件的 UI 是没法申请专利，UX 需要具体到独到的交互流程。且专利权具有地域性。</p><p>这种事，大多时候最多公开声讨下。</p></div>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        <div id=\"r_18218561\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/612b/2735/130165_normal.png?m=1786797253\" alt=\"akring\" data-uid=\"130165\"></td>\n                <td></td>\n                <td><p><span>10</span></p>\n                    \n                    <strong><a href=\"/member/akring\">akring</a></strong> &#160; &#160; &#160;<span title=\"2026-10-25 15:14:39 +08:00\">16h 9m ago</span> \n                    \n                    <p>官方的更有设计感一点</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        <div id=\"r_18218598\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/6304/a0ce/532512_normal.png?m=1791285971\" alt=\"Lukedis\" data-uid=\"532512\"></td>\n                <td></td>\n                <td><p><span>11</span></p>\n                    \n                    <strong><a href=\"/member/Lukedis\">Lukedis</a></strong> &#160; &#160; &#160;<span title=\"2026-10-25 15:42:04 +08:00\">15h 41m ago</span> \n                    \n                    <p>圆形设计用于显示额度消耗，以及将位置放置于头像附近，都属于常见设计，按照思想表达二分法，著作权只保护表达，不保护思想，受保护的表达必须具有设计的独特性，压根不构成侵权，gimp 之于 ps 就是因为这个原因才不构成侵权，额度消耗展示设计需要优化，圆形外环（缺口就是消耗）展示 5 小时额度消耗，圆内做成展示周额度（水波），目前的设计完全体现出来额度消耗</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        <div id=\"r_18218602\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/6304/a0ce/532512_normal.png?m=1791285971\" alt=\"Lukedis\" data-uid=\"532512\"></td>\n                <td></td>\n                <td><p><span>12</span></p>\n                    \n                    <strong><a href=\"/member/Lukedis\">Lukedis</a></strong> &#160; &#160; &#160;<span title=\"2026-10-25 15:44:26 +08:00\">15h 39m ago</span> \n                    \n                    <p>@<a href=\"/member/Lukedis\">Lukedis</a>  把我的这段话，发给 ChatGPT 跑一遍，就能给出不错的设计草案，禁止花里胡哨的设计，不等于放弃彩色使用</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        <div id=\"r_18218702\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/f6f1/a31e/567497_normal.png?m=1743038632\" alt=\"wweerrgtc\" data-uid=\"567497\"></td>\n                <td></td>\n                <td><p><span>13</span></p>\n                    \n                    <strong><a href=\"/member/wweerrgtc\">wweerrgtc</a></strong> &#160; &#160; &#160;<span title=\"2026-10-25 17:25:20 +08:00\">13h 58m ago via iPhone</span> \n                    \n                    <p>抄的苹果 iPhone duo</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        <div id=\"r_18218716\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/d64d/2297/66852_normal.png?m=1789095648\" alt=\"break\" data-uid=\"66852\"></td>\n                <td></td>\n                <td><p><span>14</span></p>\n                    \n                    <strong><a href=\"/member/break\">break</a></strong> &#160; <div><p>OP</p></div>&#160; &#160;<span title=\"2026-10-25 17:41:21 +08:00\">13h 42m ago</span> \n                    \n                    <p>@<a href=\"/member/quijote\">quijote</a> 本质不是侧边栏插件，功能类似插件，它是独立存在的，用技术实现跟随 codex UI 窗口启动、显示和隐藏同步</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        \n    \n    \n\n    \n        \n        <div id=\"r_18218840\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/f352/8906/309227_normal.png?m=1780325220\" alt=\"la9998372\" data-uid=\"309227\"></td>\n                <td></td>\n                <td><p><span>16</span></p>\n                    \n                    <strong><a href=\"/member/la9998372\">la9998372</a></strong> &#160; &#160; &#160;<span title=\"2026-10-25 19:49:24 +08:00\">11h 34m ago</span> \n                    \n                    <p>官方还有点不太好的地方，不会显示 5 小时的实际重置时间，现在只能去设置里面看</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n\n    \n        \n        \n    \n    \n\n    \n        \n        \n    \n    \n\n    \n        \n        <div id=\"r_18218871\">\n        \n        <table>\n            <tr>\n                <td><img src=\"https://cdn.v2ex.com/avatar/9120/a880/92158_normal.png?m=1689669248\" alt=\"haorrs\" data-uid=\"92158\"></td>\n                <td></td>\n                <td><p><span>19</span></p>\n                    \n                    <strong><a href=\"/member/haorrs\">haorrs</a></strong> &#160; &#160; &#160;<span title=\"2026-10-25 20:25:52 +08:00\">10h 58m ago</span> \n                    \n                    <p>我的界面上咋没有这个功能</p>\n                </td>\n            </tr>\n        </table>\n        </div>\n    \n    \n    \n    \n\n\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n      