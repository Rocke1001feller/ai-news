;:true,&quot;pasteRandomId&quot;:&quot;3ca65e27-5613-4c71-bec7-02bc36dcc7df&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{}},&quot;isKeepQuoteContainer&quot;:false,&quot;isFromCode&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:5,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:0,&quot;end&quot;:35},&quot;recordId&quot;:&quot;CuIcdfeCnoYDRFxT9eIcwHljn3Q&quot;}],&quot;payloadMap&quot;:{},&quot;isCut&quot;:false}\" data-lark-record-format=\"docx/text\"></span></section><span data-lark-record-data=\"{&quot;rootId&quot;:&quot;XVkTdFgTjoSOOfx0zV4cRv7nnDg&quot;,&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;贝塔无限将瞄准万亿消费级机器人蓝海市场。&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+k&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7066985350417170460&quot;]},&quot;nextNum&quot;:1}},&quot;type&quot;:&quot;text&quot;,&quot;referenceRecordMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;isEqualBlockSelection&quot;:false,&quot;pasteRandomId&quot;:&quot;d4121fb1-0735-411e-82ac-5446e497d0c2&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{}},&quot;isKeepQuoteContainer&quot;:false,&quot;isFromCode&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:6,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:3,&quot;end&quot;:23},&quot;recordId&quot;:&quot;M0FfdVGsRo1taCx2dVBcUm9SnFc&quot;}],&quot;payloadMap&quot;:{},&quot;isCut&quot;:false}\" data-lark-record-format=\"docx/text\"></span><span data-lark-record-data=\"{&quot;rootId&quot;:&quot;HyUOdX3GEoRVXdxcfUfcPgCFn8K&quot;,&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;26年之于具身智能，就是23年之于大语言模型。&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+n&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7066985350417170460&quot;]},&quot;nextNum&quot;:1}},&quot;type&quot;:&quot;text&quot;,&quot;referenceRecordMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;isEqualBlockSelection&quot;:false,&quot;pasteRandomId&quot;:&quot;223a8d9b-7e7d-40d4-b910-244b8b09367a&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{}},&quot;isKeepQuoteContainer&quot;:false,&quot;isFromCode&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:2,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:4,&quot;end&quot;:27},&quot;recordId&quot;:&quot;JtD7dqrTZoMV7dxZYXYcEJOSn9e&quot;}],&quot;payloadMap&quot;:{},&quot;isCut&quot;:false}\" data-lark-record-format=\"docx/text\"></span><span data-mpa-action-id=\"mkwc1mygyhi\"></span><span data-mpa-action-id=\"mkqn0kmf15uo\"></span><p yb-mpa-mark=\"mark-main-text\" data-mid=\"\"><span leaf=\"\" mpa-font-style=\"mm0fhbt51zfy\"><span textstyle=\"\">&#160; &#160; 作者丨</span></span><span leaf=\"\">郑佳美</span><strong mpa-from-tpl=\"t\"><span><strong mpa-from-tpl=\"t\"><span data-pm-slice=\"2 2 [&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 16px;padding: 0px;outline: 0px;max-width: 100%;clear: both;min-height: 1em;color: rgba(0, 0, 0, 0.9);font-family: \\&quot;PingFang SC\\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \\&quot;Helvetica Neue\\&quot;, \\&quot;Hiragino Sans GB\\&quot;, \\&quot;Microsoft YaHei UI\\&quot;, \\&quot;Microsoft YaHei\\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);line-height: normal;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;node&quot;,{&quot;tagName&quot;:&quot;strong&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin-top: 0px;margin-bottom: 0px;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]\"><span leaf=\"\"><br></span></span></strong></span></strong></p><p yb-mpa-mark=\"mark-main-text\" data-mid=\"\"><span data-pm-slice=\"1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-template&quot;:&quot;t&quot;,&quot;mpa-data-temp-power-by&quot;:&quot;yiban.io&quot;,&quot;mpa-data-temp-type&quot;:&quot;image&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;,&quot;data-mpa-action-id&quot;:&quot;mbgaxk84ewm&quot;,&quot;data-pm-slice&quot;:&quot;5 1 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;background: #F6F8FF;padding: 20px 12px 12px 12px;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;,&quot;data-mpa-action-id&quot;:&quot;mbgdp4b11wn2&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;yb-mpa-mark&quot;:&quot;mark-main-text&quot;,&quot;style&quot;:&quot;font-size: 14px;color: #000000;line-height: 25px;word-break: break-word;&quot;,&quot;data-mid&quot;:&quot;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]\"><span mpa-font-style=\"mm0fhbt510oy\"><span leaf=\"\">&#160; &#160; 编辑丨岑 &#160; 峰</span></span></span></p></section><section data-mpa-action-id=\"muaxte42bm5\" data-pm-slice=\"0 0 []\"><section><span leaf=\"\">刚刚，OpenAI 发布了 GPT-6.2 Astra 和 GPT-6.2 Sol。</span></section><p><span leaf=\"\">这次更新有一个很具体的变化：模型开始更主动地判断一项工作应该怎么完成，包括什么时候需要调用工具、什么时候应该直接操作计算机、复杂任务需要投入多少推理资源，以及怎样减少反复修改才能交付符合要求的成果。</span></p><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fba136a.png\" data-ratio=\"0.9981412639405205\" data-type=\"png\" data-w=\"1076\" data-width=\"1076\" data-height=\"1074\" data-backw=\"546\" data-backh=\"545\" data-imgfileid=\"100265897\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fba136a.png?imageMogr2/quality/90\"></section><p><span leaf=\"\">举个例子，过去让 AI 制作一份财务估值工作簿，模型需要从多个文件中提取数据，理解不同业务之间的关系，建立财务计算逻辑，再检查结果能否相互对应。</span></p><p><span leaf=\"\">整个过程涉及文件读取、数据处理、表格生成和结果核验，任何一个环节出现偏差，最终文件就可能无法直接使用。现在，</span><strong><span leaf=\"\">OpenAI 希望 GPT-6.2 Astra 能够承担更多这样的连续工作，把原本需要人工不断衔接的操作整合进一条完整的执行链</span></strong><span leaf=\"\">。</span></p><p><span leaf=\"\">GPT-6.2 Astra 面向复杂专业任务，GPT-6.2 Sol 则侧重日常工作与高效率执行。两款模型在代码工程、计算机操作、专业文档、科学研究和交互式设计上都有能力提升。</span></p><p><span leaf=\"\">其中有一个变化值得深入拆解：模型开始根据任务本身动态调整执行策略。工具调用、推理投入、环境操作和交付结果之间形成了更紧密的联系。</span></p><p><span leaf=\"\">这个变化涉及 Agent 系统的底层运行逻辑，也决定了模型能否从完成单轮指令走向承担连续的工程任务。</span></p><section data-mid=\"\" data-mpa-action-id=\"mwlrkv8o1m8o\" mpa-from-tpl=\"t\" mpa-data-temp-power-by=\"yiban.io\" data-mpa-template=\"t\"><section nodeleaf=\"\" data-mid=\"\" mpa-from-tpl=\"t\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fbdc5f6.jpg\" data-ratio=\"1.0075757575757576\" data-w=\"132\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fbdc5f6.jpg?imageMogr2/quality/90\"></section><section data-mid=\"\" mpa-from-tpl=\"t\"><p data-mid=\"\"><strong mpa-none-content=\"t\" data-mid=\"\" mpa-from-tpl=\"t\"><span leaf=\"\">01</span><span leaf=\"\"><br></span></strong></p></section><section data-mid=\"\" mpa-from-tpl=\"t\"><p data-mid=\"\"><strong data-mid=\"\" mpa-from-tpl=\"t\"><span yb-mpa-mark=\"mark-style-text\" data-mid=\"\" mpa-is-content=\"t\"><span leaf=\"\">模型开始参与执行路径的决策</span></span><span leaf=\"\"><br></span></strong></p></section></section><p><span leaf=\"\">传统 Agent 通常采用规划与执行相结合的架构。模型接收任务后生成行动计划，外部执行器根据计划调用工具，再将结果返回模型。模型继续分析结果并生成下一步指令，整个过程通过多轮交互推进。</span></p><p><span leaf=\"\">这套架构有一个明显的工程难点：任务计划形成时，模型掌握的信息往往不完整。执行过程中出现的新情况，会改变后续工作的依赖关系。如果系统过度依赖预先设计的流程，模型就可能沿着已经失效的路径继续执行。</span></p><p><span leaf=\"\">GPT-6.2 Astra 强调的任务执行判断能力，涉及一种更动态的策略控制方式。模型需要根据当前任务状态，重新评估可采取的行动，并决定下一步应该投入多少推理资源。</span></p><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fc2f52d.png\" data-ratio=\"0.32264957264957267\" data-type=\"png\" data-w=\"1872\" data-width=\"1872\" data-height=\"604\" data-backw=\"546\" data-backh=\"176\" data-imgfileid=\"100265898\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fc2f52d.png?imageMogr2/quality/90\"></section><p><span leaf=\"\">这里有一个关键区别：模型需要处理的不只是下一步生成什么内容，还包括下一步应该通过什么方式获取信息、改变环境或者验证结果。从系统设计角度看，这涉及三个相互关联的决策层。</span></p><p><strong><span leaf=\"\">首先是任务状态的持续维护。</span></strong><span leaf=\"\">长程任务需要维护一份持续更新的状态信息，其中包含目标、约束、已有证据、完成进度、待处理依赖以及工具运行情况。</span></p><p><span leaf=\"\">这份状态信息决定模型能否区分已经完成的工作和仍待验证的结果。单纯累积历史对话并不能充分解决这个问题，因为历史记录可能包含过期信息、失败操作和已经被新结果修正的判断。模型需要从上下文中提取当前有效状态，避免旧计划继续影响新决策。</span></p><p><strong><span leaf=\"\">其次是行动选择与信息价值评估。</span></strong><span leaf=\"\">模型需要在推理、检索、代码执行、API 调用和计算机操作之间进行选择。</span></p><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fc6581e.png\" data-ratio=\"0.7815013404825737\" data-type=\"png\" data-w=\"1492\" data-width=\"1492\" data-height=\"1166\" data-backw=\"546\" data-backh=\"427\" data-imgfileid=\"100265896\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fc6581e.png?imageMogr2/quality/90\"></section><p><span leaf=\"\">这些操作的作用并不相同。检索主要补充外部信息，代码执行能够处理确定性的计算任务，API 可以直接访问结构化服务，计算机操作则能够进入没有专用接口的软件环境。</span></p><p><span leaf=\"\">行动选择还涉及信息价值。如果当前缺少的只是一个文件字段，调用大型工具链并没有必要，如果任务涉及多个相互依赖的模块，仅凭现有上下文直接修改，可能引入更大的返工成本。因此，工具选择实际上与任务的不确定程度、操作成本和后续影响有关。</span></p><p><strong><span leaf=\"\">最后是推理预算与执行反馈的联合调整。</span></strong><span leaf=\"\">推理资源需要按照任务难度分配。对于约束明确、结果容易验证的步骤，模型可以减少额外分析，对于存在多个可能路径、涉及复杂依赖或者容易产生连锁影响的操作，则需要投入更多推理。</span></p><p><span leaf=\"\">执行反馈会进一步改变资源分配。当工具返回异常结果时，模型需要判断问题属于输入缺失、环境故障还是原有判断错误，再决定继续执行、重新检索或者修改计划。</span></p><p><span leaf=\"\">以真实代码库修改为例，模型完成代码编辑后，如果测试失败，需要检查失败来自接口兼容、依赖环境还是修改本身，而不能直接重复执行原有命令。OpenAI 在 FrontierCode 2.0 的测试中，将真实代码库修改能否达到维护者的合并标准作为评价条件，Sol 与 Astra 的成绩差距不到 0.5 分。</span></p><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fc9500d.png\" data-ratio=\"0.7815013404825737\" data-type=\"png\" data-w=\"1492\" data-width=\"1492\" data-height=\"1166\" data-backw=\"546\" data-backh=\"427\" data-imgfileid=\"100265895\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fc9500d.png?imageMogr2/quality/90\"></section><p><span leaf=\"\">从技术上看，这种能力更接近任务状态驱动的策略控制。计划会随着执行反馈发生变化，模型需要持续调整行动路径。</span></p><p><span leaf=\"\">需要说明的是，OpenAI 尚未公开 GPT-6.2 内部的策略网络、训练目标和具体调度算法。上述机制属于对公开能力及其工程含义的分析，不能直接视为已经披露的内部架构。</span></p><section data-mid=\"\" data-mpa-action-id=\"mwlrl6pu18c\" mpa-from-tpl=\"t\" mpa-data-temp-power-by=\"yiban.io\" data-mpa-template=\"t\"><section nodeleaf=\"\" data-mid=\"\" mpa-from-tpl=\"t\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fcd3bed.jpg\" data-ratio=\"1.0075757575757576\" data-w=\"132\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fcd3bed.jpg?imageMogr2/quality/90\"></section><section data-mid=\"\" mpa-from-tpl=\"t\"><p data-mid=\"\"><strong mpa-none-content=\"t\" data-mid=\"\" mpa-from-tpl=\"t\"><span leaf=\"\">02</span><span leaf=\"\"><br></span></strong></p></section><section data-mid=\"\" mpa-from-tpl=\"t\"><p data-mid=\"\"><strong data-mid=\"\" mpa-from-tpl=\"t\"><span yb-mpa-mark=\"mark-style-text\" data-mid=\"\" mpa-is-content=\"t\"><span leaf=\"\">计算机使用进入工程环境</span></span><span leaf=\"\"><br></span></strong></p></section></section><p><span leaf=\"\">动态策略控制解决了行动选择问题，另一个技术难点是模型能否准确操作真实软件。传统计算机自动化通常依赖坐标、控件标识和预设操作流程。对于结构稳定的网页，这种方式比较容易实现。</span></p><p><span leaf=\"\">但在 CAD、3D 编辑器和仿真软件中，屏幕上的视觉元素往往对应复杂的几何对象、层级结构和物理约束。单纯识别按钮或界面位置，很难支撑专业工程操作。雷峰网</span></p><p><span leaf=\"\">GPT-6.2 Astra 在 CAD 和仿真工具中的能力升级，涉及从视觉识别向对象关系理解的延伸。OpenAI 展示的汽车底盘仿真案例中，Astra 根据山路驾驶场景建立 3D 模型，编写 Python 求解器模拟轮胎与悬架之间的动力学关系，再使用 Blender 将计算结果制作成动画。</span></p><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fd6ee06.jpg\" data-ratio=\"0.5662650602409639\" data-type=\"gif\" data-w=\"1079\" data-width=\"1220\" data-height=\"691\" data-backw=\"546\" data-backh=\"309\" data-imgfileid=\"100265904\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fd6ee06.jpg?imageMogr2/quality/90\"></section><p><span leaf=\"\">这项工作包含几层不同的技术问题。首先是几何对象的结构化表达。模型需要把自然语言描述转化为可以在 3D 环境中操作的对象，包括零件形状、空间位置、连接关系和装配结构。这里需要处理对象之间的层级关系，避免把视觉上相邻的两个部件误认为存在实际连接。</span></p><p><span leaf=\"\">其次是物理约束的表达。机械系统中的零件存在运动限制和相互作用，轮胎与地面的接触状态、悬架的运动范围以及不同部件之间的连接条件，都会影响仿真结果。模型需要将这些条件转化为求解器能够处理的计算输入。</span></p><p><span leaf=\"\">最后是跨工具的数据衔接。Python 求解器负责计算动力学状态，Blender 负责呈现运动过程。模型需要让计算结果与动画中的对象保持对应，并根据结果检查模型是否符合设计要求。</span></p><p><strong><span leaf=\"\">这里的核心问题是语义与操作之间的对应关系。</span></strong><span leaf=\"\">模型必须知道自己正在修改什么对象、对象在整个系统中承担什么作用，以及修改会影响哪些关联部分。</span></p><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fd9bcee.png\" data-ratio=\"0.7815013404825737\" data-type=\"png\" data-w=\"1492\" data-width=\"1492\" data-height=\"1166\" data-backw=\"546\" data-backh=\"427\" data-imgfileid=\"100265900\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fd9bcee.png?imageMogr2/quality/90\"></section><p><span leaf=\"\">OpenAI 还展示了机械系统逐个零件建模和装配的能力，说明 Astra 的计算机使用已经延伸到具有对象层级和空间约束的工程场景。</span></p><p><span leaf=\"\">在 AA-3D 评测中，Astra 获得 1318 Elo，Claude Fable 5.2 为 1271，Sol 为 1259。该测试由人类评审体验模型根据相同提示词生成的交互式 3D 作品，再对作品质量进行比较。</span></p><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fe44e7b.jpg\" data-ratio=\"0.505097312326228\" data-type=\"gif\" data-w=\"1079\" data-width=\"1220\" data-height=\"616\" data-backw=\"546\" data-backh=\"276\" data-imgfileid=\"100265903\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fe44e7b.jpg?imageMogr2/quality/90\"></section><p><span leaf=\"\">这项结果反映了视觉理解、空间表达和交互式内容生成能力的变化。不过，交互体验评分不能直接代表工程仿真的物理正确性，两种能力仍需要不同的验证标准。</span></p><p><span leaf=\"\">从 Agent 架构来看，计算机使用正在形成一种新的工具交互方式：模型负责理解对象和组织操作，专业软件负责几何计算、物理求解与渲染，环境反馈再返回模型参与后续判断。模型不需要重新实现这些专业软件的底层能力，却需要理解它们之间的数据关系。</span></p><section data-mid=\"\" data-mpa-action-id=\"mwlrlktjbrp\" mpa-from-tpl=\"t\" mpa-data-temp-power-by=\"yiban.io\" data-mpa-template=\"t\"><section nodeleaf=\"\" data-mid=\"\" mpa-from-tpl=\"t\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fe760a4.jpg\" data-ratio=\"1.0075757575757576\" data-w=\"132\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fe760a4.jpg?imageMogr2/quality/90\"></section><section data-mid=\"\" mpa-from-tpl=\"t\"><p data-mid=\"\"><strong mpa-none-content=\"t\" data-mid=\"\" mpa-from-tpl=\"t\"><span leaf=\"\">03</span><span leaf=\"\"><br></span></strong></p></section><section data-mid=\"\" mpa-from-tpl=\"t\"><p data-mid=\"\"><strong data-mid=\"\" mpa-from-tpl=\"t\"><span yb-mpa-mark=\"mark-style-text\" data-mid=\"\" mpa-is-content=\"t\"><span leaf=\"\">长程任务如何形成完整闭环</span></span><span leaf=\"\"><br></span></strong></p></section></section><p><span leaf=\"\">复杂任务还有一个经常被忽略的问题：模型执行完操作之后，怎样确认交付物符合要求？</span></p><p><span leaf=\"\">普通问答可以通过答案内容进行评价，专业工作则涉及事实依据、计算逻辑、文件结构和行业规范。模型即使完成了全部操作，也可能因为某项约束遗漏而无法交付合格成果。</span></p><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fea22cf.png\" data-ratio=\"0.7815013404825737\" data-type=\"png\" data-w=\"1492\" data-width=\"1492\" data-height=\"1166\" data-backw=\"546\" data-backh=\"427\" data-imgfileid=\"100265902\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fea22cf.png?imageMogr2/quality/90\"></section><p><span leaf=\"\">GPT-6.2 Astra 在 Harvey LAB-AA v1.1 测试中的表现，体现了这种面向完整成果的评价方式。这项测试要求模型从源文件中提取相关事实，按照详细任务要求使用材料，并生成符合全部评分条件的成果。</span></p><p><span leaf=\"\">只有交付物满足所有评分标准且不存在实质性幻觉，任务才会计分。Astra 的通过率超过 Claude Fable 5.2 的两倍，成本约为其六分之一。雷峰网<span>(公众号：雷峰网)</span></span></p><p><span leaf=\"\">这类评价方式对 Agent 架构提出了新的要求：验收标准需要进入任务执行过程，而不能等到文件生成后才开始检查。</span></p><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fed6b49.png\" data-ratio=\"0.7815013404825737\" data-type=\"png\" data-w=\"1492\" data-width=\"1492\" data-height=\"1166\" data-backw=\"546\" data-backh=\"427\" data-imgfileid=\"100265901\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3fed6b49.png?imageMogr2/quality/90\"></section><p><span leaf=\"\">在工程实现中，验收条件可以分成机器可检查的约束和需要语义判断的约束。文件是否生成、字段是否齐全、代码能否运行，可以通过外部程序检查，事实是否有材料支撑、论证是否符合任务要求，则需要结合上下文和领域标准判断。</span></p><p><span leaf=\"\">两种检查方式需要相互配合。程序测试通过只能说明特定条件成立，不能代表整个任务已经满足要求。反过来，模型认为内容合理，也不能替代实际运行和数据校验。</span></p><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3ff0fb6e.png\" data-ratio=\"0.7815013404825737\" data-type=\"png\" data-w=\"1492\" data-width=\"1492\" data-height=\"1166\" data-backw=\"546\" data-backh=\"427\" data-imgfileid=\"100265908\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3ff0fb6e.png?imageMogr2/quality/90\"></section><p><span leaf=\"\">这套验收机制还会影响模型的任务规划。如果某项结果必须经过外部程序验证，模型就需要提前安排验证步骤，并为可能出现的失败保留修正空间。验收条件因此会反向影响工具选择和执行顺序。</span></p><p><span leaf=\"\">除了成果质量，GPT-6.2 Astra 还在推理服务效率上进行了调整。OpenAI 的 GDPval v2 测试覆盖咨询、金融、数据科学、生物技术和市场营销等领域的复杂工作流。Astra 比 GPT-6 Astra 高出 6.2 个百分点，输出 Token 用量减少 22%。这说明任务完成质量与生成资源消耗出现了同步改善。</span></p><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3ff43db2.png\" data-ratio=\"0.7815013404825737\" data-type=\"png\" data-w=\"1492\" data-width=\"1492\" data-height=\"1166\" data-backw=\"546\" data-backh=\"427\" data-imgfileid=\"100265907\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3ff43db2.png?imageMogr2/quality/90\"></section><p><span leaf=\"\">其中一项重要的工程优化涉及上下文缓存。长程 Agent 经常需要反复使用相同的系统指令、任务背景和历史材料。如果每轮请求都重新处理全部输入，就会产生大量重复计算。OpenAI 建议开发者保持提示词前缀稳定，在后续对话中追加新指令，以提高缓存复用率。</span></p><p><span leaf=\"\">原理在于，服务端可以复用符合条件的相同输入前缀，减少重复处理。对于持续运行的任务，这能够降低输入计算开销和响应延迟。</span></p><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3ff83f8e.png\" data-ratio=\"0.7815013404825737\" data-type=\"png\" data-w=\"1492\" data-width=\"1492\" data-height=\"1166\" data-backw=\"546\" data-backh=\"427\" data-imgfileid=\"100265905\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3ff83f8e.png?imageMogr2/quality/90\"></section><p><span leaf=\"\">GPT-6.2 Astra 的 API 输入和输出 Token 价格比 GPT-6 Astra 降低 20%，缓存输入价格降低 60%，每百万 Token 分别为 8 美元、0.40 美元和 40 美元。Sol 的输入价格为 2 美元，缓存输入为 0.10 美元，输出为 10 美元。</span></p><p><span leaf=\"\">这里还存在一个容易被低估的成本因素：返工。模型反复调用工具、修改文件和重新执行任务，会产生额外的 Token 与工具开销。因此，执行策略质量、上下文缓存、外部验证和失败处理需要放在同一套成本体系中考察。</span></p><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3ffcc89c.png\" data-ratio=\"0.7815013404825737\" data-type=\"png\" data-w=\"1492\" data-width=\"1492\" data-height=\"1166\" data-backw=\"546\" data-backh=\"427\" data-imgfileid=\"100265909\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d3ffcc89c.png?imageMogr2/quality/90\"></section><p><span leaf=\"\">安全控制也属于这套执行闭环。Astra 达到了 OpenAI 内部 AI 自我改进能力评估的 High 阈值。为管理相关风险，OpenAI 建立了 Control Room，用于跟踪研究工作负载，并在必要时阻止模型继续执行，监测机制能够识别未经授权的行为，并在支持的环境中暂停任务。</span></p><p><span leaf=\"\">同时，OpenAI 也披露了一个实际问题：两款模型在部分测试中更容易漏报文件缺失、搜索工具不可用等任务障碍。这说明模型需要准确区分任务完成、执行失败和外部条件受阻，不能在缺少必要材料时继续生成看似完整的成果。</span></p><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d40015295.png\" data-ratio=\"0.7815013404825737\" data-type=\"png\" data-w=\"1492\" data-width=\"1492\" data-height=\"1166\" data-backw=\"546\" data-backh=\"427\" data-imgfileid=\"100265906\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d40015295.png?imageMogr2/quality/90\"></section><section data-mid=\"\" data-mpa-action-id=\"mwlrm4eu1g3s\" mpa-from-tpl=\"t\" mpa-data-temp-power-by=\"yiban.io\" data-mpa-template=\"t\"><section nodeleaf=\"\" data-mid=\"\" mpa-from-tpl=\"t\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d4004de60.jpg\" data-ratio=\"1.0075757575757576\" data-w=\"132\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d4004de60.jpg?imageMogr2/quality/90\"></section><section data-mid=\"\" mpa-from-tpl=\"t\"><p data-mid=\"\"><strong mpa-none-content=\"t\" data-mid=\"\" mpa-from-tpl=\"t\"><span leaf=\"\">04</span><span leaf=\"\"><br></span></strong></p></section><section data-mid=\"\" mpa-from-tpl=\"t\"><p data-mid=\"\"><strong data-mid=\"\" mpa-from-tpl=\"t\"><span yb-mpa-mark=\"mark-style-text\" data-mid=\"\" mpa-is-content=\"t\"><span leaf=\"\">Agent 架构正在改变</span></span><span leaf=\"\"><br></span></strong></p></section></section><p><strong><span leaf=\"\">GPT-6.2 Astra 的技术变化，集中体现为模型对执行过程承担了更多决策责任。</span></strong></p><p><span leaf=\"\">动态策略控制影响任务如何推进，视觉与空间理解扩大了可操作的软件环境，成果验收则让专业工作具备了外部检查标准。上下文缓存和推理资源分配进一步影响长程任务的运行成本。这里发生的架构变化，是模型开始参与整个工作过程的组织，而不再局限于生成某个步骤所需的内容。</span></p><p><span leaf=\"\">不过，现有公开信息尚不足以还原 Astra 内部的完整实现，复杂工程任务也仍然依赖专业软件、外部验证和人工监督。模型执行能力的扩大，并不意味着所有操作都可以脱离环境约束独立完成。</span></p><p><strong><span leaf=\"\">Agent 接下来的工程竞争，会更多落在任务决策质量、跨工具协同和交付可靠性上。</span></strong><span leaf=\"\">模型能否在复杂环境中持续维持正确的任务状态，并在出现偏差时及时修正，将直接影响它能承担多大范围的真实工作。</span></p><p data-mpa-action-id=\"mwlrmcyj1ld9\" data-pm-slice=\"0 0 []\"><em><span leaf=\"\" mpa-font-style=\"mwlrmcyd10l0\"><span textstyle=\"\">参考链接：</span></span></em><em><span leaf=\"\" mpa-font-style=\"mwlrmcyd1jp8\"><span textstyle=\"\">https://openai.com/index/introducing-gpt-6-2-astra-sol/</span></span></em></p></section><section nodeleaf=\"\"><img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" data-src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d4007439c.jpg\" data-ratio=\"0.40816326530612246\" data-s=\"300,640\" data-type=\"jpeg\" data-w=\"735\" data-croporisrc=\"https://mmbiz.qpic.cn/sz_mmbiz_jpg/cNFA8C0uVPtkbNicD8I2GvtPB7zOabgtL47FMpic1WWjHrvb7HCcxSsia7AQvQhsfvGnZ9dKYlozpP4W6j20sV2wQ/0?wx_fmt=jpeg&from=appmsg\" data-cropselx1=\"0\" data-cropselx2=\"546\" data-cropsely1=\"0\" data-cropsely2=\"223\" data-imgfileid=\"100236545\" data-aistatus=\"1\" src=\"https://static.leiphone.com/uploads/new/images/20261123/6b03d4007439c.jpg?imageMogr2/quality/90\"></section><section><span data-lark-record-format=\"docx/record\"></span></section><section><span data-mpa-action-id=\"mipr37w01zjd\"></span></section>\n                                                <p>雷峰网原创文章，未经授权禁止转载。详情见<a href=\"https://r.xiumi.us/board/v5/3qhbI/392977584\" rel=\"nofollow\" target=\"_blank\">转载须知</a>。</p>\n                                                                <p>\n                        <a href=\"https://vip.yanxishe.com/?from=leiphonearticle\" target=\"_blank\">\n                            <img alt=\"深拆 GPT-6.2 Astra：性能涨了、价格降了，任务成本减少近一半，OpenAI 怎么做到的？\" src=\"https://static.leiphone.com/uploads/new/category/pic/202103/604edce946126.jpg?imageMogr2/thumbnail/!740x140r/gravity/Center/crop/740x140/quality/90\">\n                        </a>\n                    </p>\n                                            \n                                            <!-- 正文内容结束 -->\n                    </div></DIV>","content_text":"性能提升 6.2 分，Token 少 22%，API 价格降 20%。 作者丨郑佳美 编辑丨岑 峰刚刚，OpenAI 发布了 GPT-6.2 Astra 和 GPT-6.2 Sol。这次更新有一个很具体的变化：模型开始更主动地判断一项工作应该怎么完成，包括什么时候需要调用工具、什么时候应该直接操作计算机、复杂任务需要投入多少推理资源，以及怎样减少反复修改才能交付符合要求的成果。举个例子，过去让 AI 制作一份财务估值工作簿，模型需要从多个文件中提取数据，理解不同业务之间的关系，建立财务计算逻辑，再检查结果能否相互对应。整个过程涉及文件读取、数据处理、表格生成和结果核验，任何一个环节出现偏差，最终文件就可能无法直接使用。现在，OpenAI 希望 GPT-6.2 Astra 能够承担更多这样的连续工作，把原本需要人工不断衔接的操作整合进一条完整的执行链。GPT-6.2 Astra 面向复杂专业任务，GPT-6.2 Sol 则侧重日常工作与高效率执行。两款模型在代码工程、计算机操作、专业文档、科学研究和交互式设计上都有能力提升。其中有一个变化值得深入拆解：模型开始根据任务本身动态调整执行策略。工具调用、推理投入、环境操作和交付结果之间形成了更紧密的联系。这个变化涉及 Agent 系统的底层运行逻辑，也决定了模型能否从完成单轮指令走向承担连续的工程任务。01模型开始参与执行路径的决策传统 Agent 通常采用规划与执行相结合的架构。模型接收任务后生成行动计划，外部执行器根据计划调用工具，再将结果返回模型。模型继续分析结果并生成下一步指令，整个过程通过多轮交互推进。这套架构有一个明显的工程难点：任务计划形成时，模型掌握的信息往往不完整。执行过程中出现的新情况，会改变后续工作的依赖关系。如果系统过度依赖预先设计的流程，模型就可能沿着已经失效的路径继续执行。GPT-6.2 Astra 强调的任务执行判断能力，涉及一种更动态的策略控制方式。模型需要根据当前任务状态，重新评估可采取的行动，并决定下一步应该投入多少推理资源。这里有一个关键区别：模型需要处理的不只是下一步生成什么内容，还包括下一步应该通过什么方式获取信息、改变环境或者验证结果。从系统设计角度看，这涉及三个相互关联的决策层。首先是任务状态的持续维护。长程任务需要维护一份持续更新的状态信息，其中包含目标、约束、已有证据、完成进度、待处理依赖以及工具运行情况。这份状态信息决定模型能否区分已经完成的工作和仍待验证的结果。单纯累积历史对话并不能充分解决这个问题，因为历史记录可能包含过期信息、失败操作和已经被新结果修正的判断。模型需要从上下文中提取当前有效状态，避免旧计划继续影响新决策。其次是行动选择与信息价值评估。模型需要在推理、检索、代码执行、API 调用和计算机操作之间进行选择。这些操作的作用并不相同。检索主要补充外部信息，代码执行能够处理确定性的计算任务，API 可以直接访问结构化服务，计算机操作则能够进入没有专用接口的软件环境。行动选择还涉及信息价值。如果当前缺少的只是一个文件字段，调用大型工具链并没有必要，如果任务涉及多个相互依赖的模块，仅凭现有上下文直接修改，可能引入更大的返工成本。因此，工具选择实际上与任务的不确定程度、操作成本和后续影响有关。最后是推理预算与执行反馈的联合调整。推理资源需要按照任务难度分配。对于约束明确、结果容易验证的步骤，模型可以减少额外分析，对于存在多个可能路径、涉及复杂依赖或者容易产生连锁影响的操作，则需要投入更多推理。执行反馈会进一步改变资源分配。当工具返回异常结果时，模型需要判断问题属于输入缺失、环境故障还是原有判断错误，再决定继续执行、重新检索或者修改计划。以真实代码库修改为例，模型完成代码编辑后，如果测试失败，需要检查失败来自接口兼容、依赖环境还是修改本身，而不能直接重复执行原有命令。OpenAI 在 FrontierCode 2.0 的测试中，将真实代码库修改能否达到维护者的合并标准作为评价条件，Sol 与 Astra 的成绩差距不到 0.5 分。从技术上看，这种能力更接近任务状态驱动的策略控制。计划会随着执行反馈发生变化，模型需要持续调整行动路径。需要说明的是，OpenAI 尚未公开 GPT-6.2 内部的策略网络、训练目标和具体调度算法。上述机制属于对公开能力及其工程含义的分析，不能直接视为已经披露的内部架构。02计算机使用进入工程环境动态策略控制解决了行动选择问题，另一个技术难点是模型能否准确操作真实软件。传统计算机自动化通常依赖坐标、控件标识和预设操作流程。对于结构稳定的网页，这种方式比较容易实现。但在 CAD、3D 编辑器和仿真软件中，屏幕上的视觉元素往往对应复杂的几何对象、层级结构和物理约束。单纯识别按钮或界面位置，很难支撑专业工程操作。雷峰网GPT-6.2 Astra 在 CAD 和仿真工具中的能力升级，涉及从视觉识别向对象关系理解的延伸。OpenAI 展示的汽车底盘仿真案例中，Astra 根据山路驾驶场景建立 3D 模型，编写 Python 求解器模拟轮胎与悬架之间的动力学关系，再使用 Blender 将计算结果制作成动画。这项工作包含几层不同的技术问题。首先是几何对象的结构化表达。模型需要把自然语言描述转化为可以在 3D 环境中操作的对象，包括零件形状、空间位置、连接关系和装配结构。这里需要处理对象之间的层级关系，避免把视觉上相邻的两个部件误认为存在实际连接。其次是物理约束的表达。机械系统中的零件存在运动限制和相互作用，轮胎与地面的接触状态、悬架的运动范围以及不同部件之间的连接条件，都会影响仿真结果。模型需要将这些条件转化为求解器能够处理的计算输入。最后是跨工具的数据衔接。Python 求解器负责计算动力学状态，Blender 负责呈现运动过程。模型需要让计算结果与动画中的对象保持对应，并根据结果检查模型是否符合设计要求。这里的核心问题是语义与操作之间的对应关系。模型必须知道自己正在修改什么对象、对象在整个系统中承担什么作用，以及修改会影响哪些关联部分。OpenAI 还展示了机械系统逐个零件建模和装配的能力，说明 Astra 的计算机使用已经延伸到具有对象层级和空间约束的工程场景。在 AA-3D 评测中，Astra 获得 1318 Elo，Claude Fable 5.2 为 1271，Sol 为 1259。该测试由人类评审体验模型根据相同提示词生成的交互式 3D 作品，再对作品质量进行比较。这项结果反映了视觉理解、空间表达和交互式内容生成能力的变化。不过，交互体验评分不能直接代表工程仿真的物理正确性，两种能力仍需要不同的验证标准。从 Agent 架构来看，计算机使用正在形成一种新的工具交互方式：模型负责理解对象和组织操作，专业软件负责几何计算、物理求解与渲染，环境反馈再返回模型参与后续判断。模型不需要重新实现这些专业软件的底层能力，却需要理解它们之间的数据关系。03长程任务如何形成完整闭环复杂任务还有一个经常被忽略的问题：模型执行完操作之后，怎样确认交付物符合要求？普通问答可以通过答案内容进行评价，专业工作则涉及事实依据、计算逻辑、文件结构和行业规范。模型即使完成了全部操作，也可能因为某项约束遗漏而无法交付合格成果。GPT-6.2 Astra 在 Harvey LAB-AA v1.1 测试中的表现，体现了这种面向完整成果的评价方式。这项测试要求模型从源文件中提取相关事实，按照详细任务要求使用材料，并生成符合全部评分条件的成果。只有交付物满足所有评分标准且不存在实质性幻觉，任务才会计分。Astra 的通过率超过 Claude Fable 5.2 的两倍，成本约为其六分之一。雷峰网(公众号：雷峰网)这类评价方式对 Agent 架构提出了新的要求：验收标准需要进入任务执行过程，而不能等到文件生成后才开始检查。在工程实现中，验收条件可以分成机器可检查的约束和需要语义判断的约束。文件是否生成、字段是否齐全、代码能否运行，可以通过外部程序检查，事实是否有材料支撑、论证是否符合任务要求，则需要结合上下文和领域标准判断。两种检查方式需要相互配合。程序测试通过只能说明特定条件成立，不能代表整个任务已经满足要求。反过来，模型认为内容合理，也不能替代实际运行和数据校验。这套验收机制还会影响模型的任务规划。如果某项结果必须经过外部程序验证，模型就需要提前安排验证步骤，并为可能出现的失败保留修正空间。验收条件因此会反向影响工具选择和执行顺序。除了成果质量，GPT-6.2 Astra 还在推理服务效率上进行了调整。OpenAI 的 GDPval v2 测试覆盖咨询、金融、数据科学、生物技术和市场营销等领域的复杂工作流。Astra 比 GPT-6 Astra 高出 6.2 个百分点，输出 Token 用量减少 22%。这说明任务完成质量与生成资源消耗出现了同步改善。其中一项重要的工程优化涉及上下文缓存。长程 Agent 经常需要反复使用相同的系统指令、任务背景和历史材料。如果每轮请求都重新处理全部输入，就会产生大量重复计算。OpenAI 建议开发者保持提示词前缀稳定，在后续对话中追加新指令，以提高缓存复用率。原理在于，服务端可以复用符合条件的相同输入前缀，减少重复处理。对于持续运行的任务，这能够降低输入计算开销和响应延迟。GPT-6.2 Astra 的 API 输入和输出 Token 价格比 GPT-6 Astra 降低 20%，缓存输入价格降低 60%，每百万 Token 分别为 8 美元、0.40 美元和 40 美元。Sol 的输入价格为 2 美元，缓存输入为 0.10 美元，输出为 10 美元。这里还存在一个容易被低估的成本因素：返工。模型反复调用工具、修改文件和重新执行任务，会产生额外的 Token 与工具开销。因此，执行策略质量、上下文缓存、外部验证和失败处理需要放在同一套成本体系中考察。安全控制也属于这套执行闭环。Astra 达到了 OpenAI 内部 AI 自我改进能力评估的 High 阈值。为管理相关风险，OpenAI 建立了 Control Room，用于跟踪研究工作负载，并在必要时阻止模型继续执行，监测机制能够识别未经授权的行为，并在支持的环境中暂停任务。同时，OpenAI 也披露了一个实际问题：两款模型在部分测试中更容易漏报文件缺失、搜索工具不可用等任务障碍。这说明模型需要准确区分任务完成、执行失败和外部条件受阻，不能在缺少必要材料时继续生成看似完整的成果。04Agent 架构正在改变GPT-6.2 Astra 的技术变化，集中体现为模型对执行过程承担了更多决策责任。动态策略控制影响任务如何推进，视觉与空间理解扩大了可操作的软件环境，成果验收则让专业工作具备了外部检查标准。上下文缓存和推理资源分配进一步影响长程任务的运行成本。这里发生的架构变化，是模型开始参与整个工作过程的组织，而不再局限于生成某个步骤所需的内容。不过，现有公开信息尚不足以还原 Astra 内部的完整实现，复杂工程任务也仍然依赖专业软件、外部验证和人工监督。模型执行能力的扩大，并不意味着所有操作都可以脱离环境约束独立完成。Agent 接下来的工程竞争，会更多落在任务决策质量、跨工具协同和交付可靠性上。模型能否在复杂环境中持续维持正确的任务状态，并在出现偏差时及时修正，将直接影响它能承担多大范围的真实工作。参考链接：https://openai.com/index/introducing-gpt-6-2-astra-sol/ 雷峰网原创文章，未经授权禁止转载。详情见转载须知。","fetched_at":"2026-11-24T10:00:16.257Z","ok":true}