87992_2656-field\">Email Address</label>\n              \n            </p>","sentences":[{"en":"Email Address","zh":"电子邮件"}]},{"html_en":"<p>Thank you!</p>","sentences":[{"en":"Thank you!","zh":"谢谢你！"}]}],"translated":true,"content_html_zh":"<div class=\"page\" id=\"readability-page-1\"><div role=\"main\" id=\"page\">\n        \n          \n            <article id=\"page-regions\" data-collection-id=\"6ad7cc600468cc3b1e8f2d77\" data-item-id=\"\" data-regions-source=\"collection\">\n  \n  \n  \n    \n    \n    \n    <section data-region-id=\"6ad7cc600468cc3b1e8f2d76\" data-region-source=\"collection\">\n      \n    \n      \n        \n        \n\n\n  \n  \n\n\n\n\n\n\n\n\n\n\n\n<div data-fluid-engine=\"true\" data-test=\"page-section\" data-section-theme=\"\" data-section-id=\"6ad7cc600468cc3b1e8f2d7b\" data-controller=\"SectionWrapperController\" data-current-styles=\"{\n                  &quot;imageOverlayOpacity&quot;: 0.15,\n                  &quot;backgroundWidth&quot;: &quot;background-width--full-bleed&quot;,\n                  &quot;sectionHeight&quot;: &quot;section-height--medium&quot;,\n                  &quot;customSectionHeight&quot;: 10,\n                  &quot;horizontalAlignment&quot;: &quot;horizontal-alignment--center&quot;,\n                  &quot;verticalAlignment&quot;: &quot;vertical-alignment--middle&quot;,\n                  &quot;contentWidth&quot;: &quot;content-width--wide&quot;,\n                  &quot;customContentWidth&quot;: 50,\n                  &quot;sectionTheme&quot;: &quot;&quot;,\n                  &quot;sectionAnimation&quot;: &quot;none&quot;,\n                  &quot;backgroundMode&quot;: &quot;image&quot;\n                }\" data-current-context=\"{\n                  &quot;video&quot;: {\n                    &quot;playbackSpeed&quot;: 0.5,\n                    &quot;filter&quot;: 1,\n                    &quot;filterStrength&quot;: 0,\n                    &quot;zoom&quot;: 0,\n                    &quot;videoSourceProvider&quot;: &quot;none&quot;\n                  },\n                  &quot;backgroundImageId&quot;: null,\n                  &quot;backgroundMediaEffect&quot;: {\n                    &quot;type&quot;: &quot;none&quot;\n                  },\n                  &quot;divider&quot;: {\n                    &quot;enabled&quot;: false\n                  },\n                  &quot;typeName&quot;: &quot;page&quot;\n                }\" data-animation=\"none\" data-fluid-engine-section=\"\" data-sqsp-section=\"fluid-engine\"><div data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/efe9c818-3ed2-4e67-8c39-f956d8b224ce_999/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/efe9c818-3ed2-4e67-8c39-f956d8b224ce_999/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"f62243ef6aada77ca1c4\" id=\"block-f62243ef6aada77ca1c4\">\n  \n  <p data-sqsp-text-block-content=\"\"></p><h2 data-rte-preserve-empty=\"true\">Editor’s Note: Retraction</h2><p></p>\n\n\n  \n\n\n\n\n\n\n\n\n</div><div id=\"block-ffdd4bf8441fa29a7574\" data-website-component-id=\"ffdd4bf8441fa29a7574\" data-sqsp-block=\"text\" data-definition-name=\"website.components.html\" data-block-type=\"1337\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/efe9c818-3ed2-4e67-8c39-f956d8b224ce_999/website.components.html.visitor.js&quot;]\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/efe9c818-3ed2-4e67-8c39-f956d8b224ce_999/website.components.html.styles.css&quot;]\" data-sqsp-text-block-content=\"\"><p data-rte-preserve-empty=\"true\">October 20, 2026</p><p data-rte-preserve-empty=\"true\">On Oct. 19, the Oregon Journalism Project published a story about a video of an upside-down American flag displayed behind Washington County Commissioner Nafisa Fai at an Oct. 10 event in Minneapolis. The headline and story described the video as a “deepfake” that was circulated by right-wing social media accounts to brand Fai, a Somali immigrant, as un-American.</p><p data-rte-preserve-empty=\"true\">On Oct. 16, OJP interviewed Fai, who is running for Washington County chair. A Fai campaign supporter then provided a different video of the event to OJP that showed the flag right side up.</p><p data-rte-preserve-empty=\"true\">After publication, readers raised questions about the conflicting images. OJP then obtained new images that showed the flag at the Minneapolis event had in fact been upside down. For that reason, we have unpublished the original story. OJP regrets the error.</p></div></div>\n\n      \n    \n      \n        \n        \n\n\n  \n  \n\n\n\n\n\n\n\n\n\n\n\n<div data-fluid-engine=\"true\" data-test=\"page-section\" data-section-theme=\"\" data-section-id=\"6ad7cc600468cc3b1e8f2d7f\" data-controller=\"SectionWrapperController\" data-current-styles=\"{\n                  &quot;imageOverlayOpacity&quot;: 0.15,\n                  &quot;backgroundWidth&quot;: &quot;background-width--full-bleed&quot;,\n                  &quot;sectionHeight&quot;: &quot;section-height--small&quot;,\n                  &quot;customSectionHeight&quot;: 1,\n                  &quot;horizontalAlignment&quot;: &quot;horizontal-alignment--center&quot;,\n                  &quot;verticalAlignment&quot;: &quot;vertical-alignment--middle&quot;,\n                  &quot;contentWidth&quot;: &quot;content-width--wide&quot;,\n                  &quot;customContentWidth&quot;: 50,\n                  &quot;sectionTheme&quot;: &quot;&quot;,\n                  &quot;sectionAnimation&quot;: &quot;none&quot;,\n                  &quot;backgroundMode&quot;: &quot;image&quot;\n     